// Wyrm Compiler & LLVM IR Generator (wyrmc) v3.1.0
// Written entirely in Wyrm for self-hosting.

var token_pos = [0]
var g_tokens = [[]]
var current_source_file = [""]
var current_source_lines = [[]]

fn is_alpha(c) {
    if c == "" { return false }
    var code = ord_val(c)
    return (code >= 65 and code <= 90) or (code >= 97 and code <= 122) or c == "_"
}

fn is_digit(c) {
    if c == "" { return false }
    var code = ord_val(c)
    return code >= 48 and code <= 57
}

fn is_alphanum(c) {
    return is_alpha(c) or is_digit(c)
}

fn is_space(c) {
    return c == " " or c == "\t" or c == "\r"
}

fn tokenize(source) {
    var tokens = []
    var pos = 0
    var len_src = len(source)
    var line = 1
    var col = 1

    repeat {
        if pos >= len_src { break }
        var c = char_at(source, pos)

        if c == "\n" {
            append(tokens, ["NEWLINE", "\n", line, col])
            pos = pos + 1
            line = line + 1
            col = 1
        } elif is_space(c) {
            pos = pos + 1
            col = col + 1
        } else {
            var is_comment = false
            if c == "/" {
                if pos + 1 < len_src {
                    if char_at(source, pos + 1) == "/" {
                        is_comment = true
                    }
                }
            }
            if is_comment {
                repeat {
                    pos = pos + 1
                    col = col + 1
                    if pos >= len_src { break }
                    c = char_at(source, pos)
                } til c == "\n" or pos >= len_src
            } else {
                if is_alpha(c) {
                    var start_col = col
                    var val = ""
                    repeat {
                        val = val + c
                        pos = pos + 1
                        col = col + 1
                        if pos >= len_src { break }
                        c = char_at(source, pos)
                    } til not is_alphanum(c) or pos >= len_src
                    
                    var type = "IDENTIFIER"
                    if val == "use" or val == "fn" or val == "var" or val == "dec" or val == "owned" or val == "arena" or val == "if" or val == "elif" or val == "else" or val == "repeat" or val == "do" or val == "til" or val == "struct" or val == "unsafe" or val == "return" or val == "break" or val == "continue" or val == "print" or val == "and" or val == "or" or val == "not" or val == "true" or val == "false" or val == "null" or val == "try" or val == "catch" {
                        type = "KEYWORD"
                    }
                    append(tokens, [type, val, line, start_col])
                } elif is_digit(c) {
                    var start_col = col
                    var val = ""
                    var has_dot = false
                    repeat {
                        if c == "." { has_dot = true }
                        val = val + c
                        pos = pos + 1
                        col = col + 1
                        if pos >= len_src { break }
                        c = char_at(source, pos)
                    } til (not is_digit(c) and c != ".") or pos >= len_src
                    append(tokens, ["NUMBER", val, line, start_col])
                } elif c == "\"" {
                    var start_col = col
                    var val = ""
                    pos = pos + 1
                    col = col + 1
                    var closed = false
                    repeat {
                        if pos >= len_src { break }
                        c = char_at(source, pos)
                        if c == "\"" {
                            closed = true
                            pos = pos + 1
                            col = col + 1
                            break
                        }
                        if c == "\\" and pos + 1 < len_src {
                            var next_c = char_at(source, pos + 1)
                            if next_c == "n" {
                                val = val + "\n"
                            } elif next_c == "t" {
                                val = val + "\t"
                            } elif next_c == "r" {
                                val = val + "\r"
                            } elif next_c == "\\" {
                                val = val + "\\"
                            } elif next_c == "\"" {
                                val = val + "\""
                            } else {
                                val = val + "\\" + next_c
                            }
                            pos = pos + 2
                            col = col + 2
                        } else {
                            val = val + c
                            pos = pos + 1
                            col = col + 1
                        }
                    } til pos >= len_src
                    if not closed {
                        report_diagnostic("E0003", "unterminated string literal", line, start_col, "add closing quote")
                    }
                    append(tokens, ["STRING", val, line, start_col])
                } else {
                    var start_col = col
                    var val2 = ""
                    if pos + 1 < len_src {
                        val2 = c + char_at(source, pos + 1)
                    }
                    if val2 == "==" or val2 == "!=" or val2 == "<=" or val2 == ">=" or val2 == "&&" or val2 == "||" or val2 == "**" or val2 == "//" or val2 == "+=" or val2 == "-=" or val2 == "*=" or val2 == "/=" or val2 == "->" {
                        append(tokens, ["OPERATOR", val2, line, start_col])
                        pos = pos + 2
                        col = col + 2
                    } else {
                        var type = "DELIMITER"
                        if c == "+" or c == "-" or c == "*" or c == "/" or c == "%" or c == "=" or c == "!" or c == "<" or c == ">" {
                            type = "OPERATOR"
                        }
                        append(tokens, [type, c, line, start_col])
                        pos = pos + 1
                        col = col + 1
                    }
                }
            }
        }
    } til pos >= len_src

    append(tokens, ["EOF", "", line, col])
    return tokens
}

fn contains_val(lst, val) {
    var i = 0
    var l = len(lst)
    repeat {
        if i >= l { break }
        if lst[i] == val { return true }
        i = i + 1
    } til i >= l
    return false
}

// Parser State Helpers
fn current() {
    var tokens_list = g_tokens[0]
    var pos = token_pos[0]
    return tokens_list[pos]
}

fn cur_type() {
    var tok = current()
    return tok[0]
}

fn cur_val() {
    var tok = current()
    return tok[1]
}

fn peek_val() {
    var tokens_list = g_tokens[0]
    var pos = token_pos[0] + 1
    if pos < len(tokens_list) {
        var tok = tokens_list[pos]
        return tok[1]
    }
    return ""
}

fn advance() {
    token_pos[0] = token_pos[0] + 1
}

fn report_diagnostic(err_code, title, line_no, col_no, hint_msg) {
    print("error[" + err_code + "]: " + title)
    var file_str = current_source_file[0]
    if file_str == "" { file_str = "source.wyr" }
    print("  --> " + file_str + ":" + str(line_no) + ":" + str(col_no))
    print("   |")
    
    var lines_list = current_source_lines[0]
    if line_no > 0 and line_no <= len(lines_list) {
        var src_line = lines_list[line_no - 1]
        var line_prefix = " " + str(line_no) + " | "
        print(line_prefix + src_line)
        
        var pad = "   | "
        var c = 1
        repeat {
            if c >= col_no { break }
            pad = pad + " "
            c = c + 1
        } til c >= col_no
        print(pad + "^ " + hint_msg)
    } else {
        print("   |   ^ " + hint_msg)
    }
    print("   |")
    exit(1)
}

fn expect(type, val) {
    var tok = current()
    if tok[0] != type or tok[1] != val {
        report_diagnostic("E0001", "syntax error: unexpected token", tok[2], tok[3], "expected '" + val + "', got '" + tok[1] + "'")
    }
    advance()
}

// Parser Implementation
fn parse_tokens(tokens) {
    g_tokens[0] = tokens
    token_pos[0] = 0
    var statements = []
    repeat {
        var tok = current()
        if tok[0] == "EOF" { break }
        if tok[0] == "NEWLINE" {
            advance()
        } else {
            append(statements, parse_statement())
        }
    } til false
    return statements
}

fn parse_statement() {
    var res = parse_statement_inner()
    if cur_val() == ";" {
        advance()
    }
    return res
}

fn parse_statement_inner() {
    var tok = current()
    if tok[0] == "KEYWORD" {
        if tok[1] == "use" {
            advance()
            var path = ""
            repeat {
                var cur_tok = current()
                if cur_tok[0] == "EOF" or cur_tok[0] == "NEWLINE" or cur_tok[1] == ";" { break }
                path = path + cur_tok[1]
                advance()
            } til false
            return ["Use", path]
        }
        if tok[1] == "fn" {
            advance()
            var name = cur_val()
            advance()
            expect("DELIMITER", "(")
            var params = []
            if cur_val() != ")" {
                repeat {
                    var p_name = cur_val()
                    advance()
                    var p_type = ""
                    if cur_val() == ":" {
                        advance()
                        p_type = cur_val()
                        advance()
                    }
                    append(params, p_name)
                    if cur_val() == "," {
                        advance()
                    } else { break }
                } til false
            }
            expect("DELIMITER", ")")
            var returns_error = false
            var ret_type = ""
            if cur_val() == "->" or cur_val() == ":" {
                advance()
                if cur_val() == "!" {
                    returns_error = true
                    advance()
                }
                ret_type = cur_val()
                advance()
            }
            expect("DELIMITER", "{")
            var body = []
            repeat {
                if cur_val() == "}" { break }
                if cur_type() == "NEWLINE" {
                    advance()
                } else {
                    append(body, parse_statement())
                }
            } til false
            expect("DELIMITER", "}")
            return ["FuncDef", name, params, body, returns_error, ret_type]
        }
        if tok[1] == "var" or tok[1] == "dec" or tok[1] == "owned" {
            var type = tok[1]
            advance()
            var name = cur_val()
            advance()
            var v_type = ""
            if cur_val() == ":" {
                advance()
                v_type = cur_val()
                advance()
            }
            expect("OPERATOR", "=")
            var val = parse_expression()
            return ["VarDecl", type, name, val, v_type]
        }
        if tok[1] == "arena" {
            advance()
            var name = cur_val()
            advance()
            expect("DELIMITER", "(")
            var size = parse_expression()
            expect("DELIMITER", ")")
            return ["Arena", name, size]
        }
        if tok[1] == "struct" {
            advance()
            var name = cur_val()
            advance()
            expect("DELIMITER", "{")
            var fields = []
            var methods = []
            repeat {
                if cur_val() == "}" { break }
                if cur_type() == "NEWLINE" {
                    advance()
                } elif cur_val() == "fn" {
                    append(methods, parse_statement())
                } else {
                    var f_name = cur_val()
                    advance()
                    var f_type = ""
                    if cur_val() == ":" {
                        advance()
                        f_type = cur_val()
                        advance()
                    }
                    append(fields, f_name)
                    if cur_val() == "," or cur_val() == ";" { advance() }
                }
            } til false
            expect("DELIMITER", "}")
            return ["StructDef", name, fields, methods]
        }
        if tok[1] == "if" {
            advance()
            var cond = parse_expression()
            expect("DELIMITER", "{")
            var then_body = []
            repeat {
                if cur_val() == "}" { break }
                if cur_type() == "NEWLINE" {
                    advance()
                } else {
                    append(then_body, parse_statement())
                }
            } til false
            expect("DELIMITER", "}")
            var elif_clauses = []
            repeat {
                if cur_val() == "elif" {
                    advance()
                    var elif_cond = parse_expression()
                    expect("DELIMITER", "{")
                    var elif_body = []
                    repeat {
                        if cur_val() == "}" { break }
                        if cur_type() == "NEWLINE" {
                            advance()
                        } else {
                            append(elif_body, parse_statement())
                        }
                    } til false
                    expect("DELIMITER", "}")
                    append(elif_clauses, [elif_cond, elif_body])
                } else { break }
            } til false
            var else_body = []
            if cur_val() == "else" {
                advance()
                expect("DELIMITER", "{")
                repeat {
                    if cur_val() == "}" { break }
                    if cur_type() == "NEWLINE" {
                        advance()
                    } else {
                        append(else_body, parse_statement())
                    }
                } til false
                expect("DELIMITER", "}")
            }
            return ["If", cond, then_body, elif_clauses, else_body]
        }
        if tok[1] == "repeat" or tok[1] == "do" {
            advance()
            expect("DELIMITER", "{")
            var body = []
            repeat {
                if cur_val() == "}" { break }
                if cur_type() == "NEWLINE" {
                    advance()
                } else {
                    append(body, parse_statement())
                }
            } til false
            expect("DELIMITER", "}")
            expect("KEYWORD", "til")
            var cond = parse_expression()
            return ["Repeat", body, cond]
        }
        if tok[1] == "try" and peek_val() == "{" {
            advance()
            expect("DELIMITER", "{")
            var try_body = []
            repeat {
                if cur_val() == "}" { break }
                if cur_type() == "NEWLINE" {
                    advance()
                } else {
                    append(try_body, parse_statement())
                }
            } til false
            expect("DELIMITER", "}")
            expect("KEYWORD", "catch")
            var err_var = cur_val()
            advance()
            expect("DELIMITER", "{")
            var catch_body = []
            repeat {
                if cur_val() == "}" { break }
                if cur_type() == "NEWLINE" {
                    advance()
                } else {
                    append(catch_body, parse_statement())
                }
            } til false
            expect("DELIMITER", "}")
            return ["TryCatch", try_body, err_var, catch_body]
        }
        if tok[1] == "unsafe" {
            advance()
            expect("DELIMITER", "{")
            var body = []
            repeat {
                if cur_val() == "}" { break }
                if cur_type() == "NEWLINE" {
                    advance()
                } else {
                    append(body, parse_statement())
                }
            } til false
            expect("DELIMITER", "}")
            return ["Unsafe", body]
        }
        if tok[1] == "return" {
            advance()
            var expr = null
            if cur_type() != "NEWLINE" and cur_val() != "}" and cur_val() != ";" {
                expr = parse_expression()
            }
            if cur_val() == ";" {
                advance()
            }
            return ["Return", expr]
        }
        if tok[1] == "break" {
            advance()
            return ["Break"]
        }
        if tok[1] == "continue" {
            advance()
            return ["Continue"]
        }
        if tok[1] == "print" {
            advance()
            if cur_val() == "!" {
                advance()
            }
            expect("DELIMITER", "(")
            var exprs = []
            if cur_val() != ")" {
                repeat {
                    append(exprs, parse_expression())
                    if cur_val() == "," {
                        advance()
                    } else { break }
                } til false
            }
            expect("DELIMITER", ")")
            return ["Print", exprs]
        }
    }
    
    // Assignment or expression statement
    var expr = parse_expression()
    if cur_val() == "=" {
        advance()
        var val = parse_expression()
        if expr[0] == "Index" {
            return ["IndexAssign", expr[1], expr[2], val]
        }
        if expr[0] == "MemberAccess" {
            return ["MemberAssign", expr[1], expr[2], val]
        }
        return ["Assign", expr[1], val]
    }
    return expr
}

fn parse_expression() {
    return parse_catch()
}

fn parse_catch() {
    var node = parse_logical_or()
    repeat {
        var tok = current()
        if tok[0] == "KEYWORD" and tok[1] == "catch" {
            advance()
            var right = parse_logical_or()
            node = ["CatchExpr", node, right]
        } else { break }
    } til false
    return node
}

fn parse_logical_or() {
    var node = parse_logical_and()
    repeat {
        var tok = current()
        if tok[0] == "KEYWORD" and (tok[1] == "or" or tok[1] == "||") {
            advance()
            var right = parse_logical_and()
            node = ["BinaryOp", tok[1], node, right]
        } else { break }
    } til false
    return node
}

fn parse_logical_and() {
    var node = parse_equality()
    repeat {
        var tok = current()
        if tok[0] == "KEYWORD" and (tok[1] == "and" or tok[1] == "&&") {
            advance()
            var right = parse_equality()
            node = ["BinaryOp", tok[1], node, right]
        } else { break }
    } til false
    return node
}

fn parse_equality() {
    var node = parse_comparison()
    repeat {
        var tok = current()
        if tok[0] == "OPERATOR" and (tok[1] == "==" or tok[1] == "!=") {
            advance()
            var right = parse_comparison()
            node = ["BinaryOp", tok[1], node, right]
        } else { break }
    } til false
    return node
}

fn parse_comparison() {
    var node = parse_addition_subtraction()
    repeat {
        var tok = current()
        if tok[0] == "OPERATOR" and (tok[1] == "<" or tok[1] == ">" or tok[1] == "<=" or tok[1] == ">=") {
            advance()
            var right = parse_addition_subtraction()
            node = ["BinaryOp", tok[1], node, right]
        } else { break }
    } til false
    return node
}

fn parse_addition_subtraction() {
    var node = parse_multiplication_division()
    repeat {
        var tok = current()
        if tok[0] == "OPERATOR" and (tok[1] == "+" or tok[1] == "-") {
            advance()
            var right = parse_multiplication_division()
            node = ["BinaryOp", tok[1], node, right]
        } else { break }
    } til false
    return node
}

fn parse_multiplication_division() {
    var node = parse_power()
    repeat {
        var tok = current()
        if tok[0] == "OPERATOR" and (tok[1] == "*" or tok[1] == "/" or tok[1] == "//" or tok[1] == "%") {
            advance()
            var right = parse_power()
            node = ["BinaryOp", tok[1], node, right]
        } else { break }
    } til false
    return node
}

fn parse_power() {
    var node = parse_unary()
    repeat {
        var tok = current()
        if tok[0] == "OPERATOR" and tok[1] == "**" {
            advance()
            var right = parse_unary()
            node = ["BinaryOp", tok[1], node, right]
        } else { break }
    } til false
    return node
}

fn parse_unary() {
    var tok = current()
    if (tok[0] == "OPERATOR" and (tok[1] == "not" or tok[1] == "!" or tok[1] == "-" or tok[1] == "+")) or (tok[0] == "KEYWORD" and tok[1] == "not") {
        advance()
        var expr = parse_unary()
        return ["UnaryOp", tok[1], expr]
    }
    if tok[0] == "KEYWORD" and tok[1] == "try" {
        advance()
        var expr = parse_unary()
        return ["TryExpr", expr]
    }
    return parse_primary()
}

fn parse_primary() {
    var tok = current()
    if tok[0] == "NUMBER" {
        advance()
        return ["Number", tok[1]]
    }
    if tok[0] == "STRING" {
        advance()
        return ["String", tok[1]]
    }
    if tok[0] == "KEYWORD" {
        if tok[1] == "true" or tok[1] == "false" {
            advance()
            return ["Boolean", tok[1]]
        }
        if tok[1] == "null" {
            advance()
            return ["None"]
        }
    }
    if tok[0] == "IDENTIFIER" {
        var name = tok[1]
        advance()
        
        var is_macro = false
        if cur_val() == "!" and peek_val() == "(" {
            is_macro = true
            advance()
        }
        
        // Function call
        if cur_val() == "(" {
            advance()
            var args = []
            if cur_val() != ")" {
                repeat {
                    append(args, parse_expression())
                    if cur_val() == "," {
                        advance()
                    } else { break }
                } til false
            }
            expect("DELIMITER", ")")
            return ["FuncCall", ["Identifier", name], args]
        }
        // Indexing or slice
        if cur_val() == "[" {
            advance()
            if cur_val() == ":" {
                advance()
                var end = parse_expression()
                expect("DELIMITER", "]")
                return ["Index", ["Identifier", name], ["Slice", null, end]]
            }
            var expr = parse_expression()
            if cur_val() == ":" {
                advance()
                var end = null
                if cur_val() != "]" {
                    end = parse_expression()
                }
                expect("DELIMITER", "]")
                return ["Index", ["Identifier", name], ["Slice", expr, end]]
            }
            expect("DELIMITER", "]")
            return ["Index", ["Identifier", name], expr]
        }
        // Dot access: MemberAccess, MethodCall, or Arena alloc/reset
        if cur_val() == "." {
            advance()
            var member_or_method = cur_val()
            advance()
            if cur_val() == "(" {
                advance()
                if member_or_method == "alloc" {
                    var size = parse_expression()
                    expect("DELIMITER", ")")
                    return ["ArenaAlloc", name, size]
                }
                if member_or_method == "reset" {
                    expect("DELIMITER", ")")
                    return ["ArenaReset", name]
                }
                var args = []
                if cur_val() != ")" {
                    repeat {
                        append(args, parse_expression())
                        if cur_val() == "," {
                            advance()
                        } else { break }
                    } til false
                }
                expect("DELIMITER", ")")
                return ["MethodCall", ["Identifier", name], member_or_method, args]
            }
            return ["MemberAccess", ["Identifier", name], member_or_method]
        }
        return ["Identifier", name]
    }
    if tok[1] == "(" {
        advance()
        var expr = parse_expression()
        expect("DELIMITER", ")")
        return expr
    }
    if tok[1] == "[" {
        advance()
        var elements = []
        if cur_val() != "]" {
            repeat {
                append(elements, parse_expression())
                if cur_val() == "," {
                    advance()
                } else { break }
            } til false
        }
        expect("DELIMITER", "]")
        return ["List", elements]
    }
    
    report_diagnostic("E0002", "syntax error: unexpected token " + tok[0] + " '" + tok[1] + "'", tok[2], tok[3], "expression expected")
}

// LLVM IR Code Generator State
var temp_count = [0]
var g_allocas = [[]]
var g_main_allocas = [[]]
var g_insts = [[]]
var g_llvm_globals = []
var g_llvm_decls = []
var g_llvm_funcs = []
var g_llvm_main = []
var g_scopes = [[]]
var g_catch_labels = [[]]
var g_catch_vars = [[]]
var in_function = [false]
var in_unsafe = [false]
var has_main_def = [false]
var declared_globals = [[]]
var emitted_globals = [[]]
var declared_locals = [[]]
var constants = []
var g_loop_breaks = [[]]
var g_loop_continues = [[]]

// Static Type Analysis State & Helpers
var current_local_types = []

fn has_dot(s) {
    var i = 0
    var l = len(s)
    repeat {
        if i >= l { break }
        if char_at(s, i) == "." { return true }
        i = i + 1
    } til i >= l
    return false
}

fn is_array(v) {
    if v == null { return false }
    var t = type(v)
    return t == "array" or t == "Array"
}

fn is_unboxed_type(t) {
    return t == "i32" or t == "int" or t == "i64" or t == "u8" or t == "f32" or t == "f64" or t == "float" or t == "Number" or t == "bool"
}

fn canonical_type(t) {
    if t == "i32" or t == "int" { return "i32" }
    if t == "i64" { return "i64" }
    if t == "u8" { return "u8" }
    if t == "f32" { return "f32" }
    if t == "f64" or t == "float" or t == "Number" { return "f64" }
    if t == "bool" { return "bool" }
    return "Dynamic"
}

fn get_llvm_type(t) {
    var c = canonical_type(t)
    if c == "i32" { return "i32" }
    if c == "i64" { return "i64" }
    if c == "u8" { return "i8" }
    if c == "f32" { return "float" }
    if c == "f64" { return "double" }
    if c == "bool" { return "i1" }
    return "%struct.Value"
}

fn get_llvm_align(t) {
    var c = canonical_type(t)
    if c == "i32" { return "4" }
    if c == "i64" { return "8" }
    if c == "u8" { return "1" }
    if c == "f32" { return "4" }
    if c == "f64" { return "8" }
    if c == "bool" { return "1" }
    return "8"
}

fn can_gen_unboxed(node, target_t) {
    if not is_array(node) { return false }
    target_t = canonical_type(target_t)
    var n_type = node[0]
    if n_type == "Number" {
        if target_t == "i32" or target_t == "i64" or target_t == "u8" {
            return not has_dot(node[1])
        }
        if target_t == "f32" or target_t == "f64" {
            return true
        }
        if target_t == "bool" {
            return node[1] == "0" or node[1] == "1"
        }
        return false
    }
    if n_type == "Boolean" {
        return target_t == "bool"
    }
    if n_type == "Identifier" {
        var vt = canonical_type(get_var_type(node[1]))
        if vt == target_t { return true }
        if target_t == "i64" and (vt == "i32" or vt == "u8") { return true }
        if target_t == "i32" and vt == "u8" { return true }
        if target_t == "f64" and (vt == "f32" or vt == "i32" or vt == "u8") { return true }
        return false
    }
    if n_type == "BinaryOp" {
        var op = node[1]
        if target_t == "bool" {
            if op == "and" or op == "or" or op == "&&" or op == "||" {
                return can_gen_unboxed(node[2], "bool") and can_gen_unboxed(node[3], "bool")
            }
            return false
        }
        if op == "+" or op == "-" or op == "*" or op == "/" or op == "%" {
            if (target_t == "f32" or target_t == "f64") and op == "%" { return false }
            return can_gen_unboxed(node[2], target_t) and can_gen_unboxed(node[3], target_t)
        }
    }
    if n_type == "UnaryOp" {
        var op = node[1]
        if op == "-" and target_t != "bool" {
            return can_gen_unboxed(node[2], target_t)
        }
        if (op == "!" or op == "not") and target_t == "bool" {
            return can_gen_unboxed(node[2], "bool")
        }
    }
    return false
}

fn gen_unboxed_expr(node, target_t) {
    target_t = canonical_type(target_t)
    if node == null {
        if target_t == "f32" or target_t == "f64" { return "0.0" }
        return "0"
    }
    var n_type = node[0]
    if n_type == "Number" {
        var val = node[1]
        if target_t == "f32" or target_t == "f64" {
            if not has_dot(val) { val = val + ".0" }
            return val
        }
        return val
    }
    if n_type == "Boolean" {
        if node[1] == "true" { return "1" }
        return "0"
    }
    if n_type == "Identifier" {
        var name = node[1]
        var vt = canonical_type(get_var_type(name))
        var reg_val = "%val_" + str(temp_count[0])
        temp_count[0] = temp_count[0] + 1
        var src_llvm_t = get_llvm_type(vt)
        var src_llvm_a = get_llvm_align(vt)
        if contains_val(declared_globals[0], name) or not in_function[0] {
            emit_inst(reg_val + " = load " + src_llvm_t + ", ptr @wyrm_var_" + name + ", align " + src_llvm_a)
        } else {
            emit_inst(reg_val + " = load " + src_llvm_t + ", ptr %wyrm_var_" + name + ", align " + src_llvm_a)
        }
        if vt != target_t {
            var conv_val = "%conv_" + str(temp_count[0])
            temp_count[0] = temp_count[0] + 1
            if vt == "u8" and target_t == "i32" {
                emit_inst(conv_val + " = zext i8 " + reg_val + " to i32")
                return conv_val
            }
            if vt == "u8" and target_t == "i64" {
                emit_inst(conv_val + " = zext i8 " + reg_val + " to i64")
                return conv_val
            }
            if vt == "i32" and target_t == "i64" {
                emit_inst(conv_val + " = sext i32 " + reg_val + " to i64")
                return conv_val
            }
            if vt == "f32" and target_t == "f64" {
                emit_inst(conv_val + " = fpext float " + reg_val + " to double")
                return conv_val
            }
            if (vt == "i32" or vt == "u8") and target_t == "f64" {
                emit_inst(conv_val + " = sitofp " + src_llvm_t + " " + reg_val + " to double")
                return conv_val
            }
        }
        return reg_val
    }
    if n_type == "BinaryOp" {
        var op = node[1]
        var left = gen_unboxed_expr(node[2], target_t)
        var right = gen_unboxed_expr(node[3], target_t)
        var res = "%op_" + str(temp_count[0])
        temp_count[0] = temp_count[0] + 1
        var llvm_t = get_llvm_type(target_t)
        if target_t == "bool" {
            if op == "and" or op == "&&" {
                emit_inst(res + " = and i1 " + left + ", " + right)
                return res
            }
            if op == "or" or op == "||" {
                emit_inst(res + " = or i1 " + left + ", " + right)
                return res
            }
        }
        if target_t == "f32" or target_t == "f64" {
            var f_instr = "fadd"
            if op == "-" {
                f_instr = "fsub"
            } elif op == "*" {
                f_instr = "fmul"
            } elif op == "/" {
                f_instr = "fdiv"
            }
            emit_inst(res + " = " + f_instr + " " + llvm_t + " " + left + ", " + right)
            return res
        }
        var i_instr = "add"
        if op == "-" {
            i_instr = "sub"
        } elif op == "*" {
            i_instr = "mul"
        } elif op == "/" {
            if target_t == "u8" {
                i_instr = "udiv"
            } else {
                i_instr = "sdiv"
            }
        } elif op == "%" {
            if target_t == "u8" {
                i_instr = "urem"
            } else {
                i_instr = "srem"
            }
        }
        emit_inst(res + " = " + i_instr + " " + llvm_t + " " + left + ", " + right)
        return res
    }
    if n_type == "UnaryOp" {
        var op = node[1]
        var llvm_t = get_llvm_type(target_t)
        var sub = gen_unboxed_expr(node[2], target_t)
        var res = "%un_" + str(temp_count[0])
        temp_count[0] = temp_count[0] + 1
        if target_t == "bool" {
            emit_inst(res + " = xor i1 " + sub + ", 1")
            return res
        }
        if target_t == "f32" or target_t == "f64" {
            emit_inst(res + " = fneg " + llvm_t + " " + sub)
            return res
        }
        emit_inst(res + " = sub " + llvm_t + " 0, " + sub)
        return res
    }
    return "0"
}

fn can_gen_static_cmp(node) {
    if not is_array(node) { return false }
    if node[0] == "BinaryOp" {
        var op = node[1]
        if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=" {
            if can_gen_unboxed(node[2], "i32") and can_gen_unboxed(node[3], "i32") { return true }
            if can_gen_unboxed(node[2], "i64") and can_gen_unboxed(node[3], "i64") { return true }
            if can_gen_unboxed(node[2], "u8") and can_gen_unboxed(node[3], "u8") { return true }
            if can_gen_unboxed(node[2], "f64") and can_gen_unboxed(node[3], "f64") { return true }
            if can_gen_unboxed(node[2], "f32") and can_gen_unboxed(node[3], "f32") { return true }
            if can_gen_unboxed(node[2], "bool") and can_gen_unboxed(node[3], "bool") { return true }
        }
    }
    return false
}

fn gen_static_cmp(node) {
    var cmp_type = "i32"
    if can_gen_unboxed(node[2], "i32") and can_gen_unboxed(node[3], "i32") {
        cmp_type = "i32"
    } elif can_gen_unboxed(node[2], "i64") and can_gen_unboxed(node[3], "i64") {
        cmp_type = "i64"
    } elif can_gen_unboxed(node[2], "u8") and can_gen_unboxed(node[3], "u8") {
        cmp_type = "u8"
    } elif can_gen_unboxed(node[2], "f64") and can_gen_unboxed(node[3], "f64") {
        cmp_type = "f64"
    } elif can_gen_unboxed(node[2], "f32") and can_gen_unboxed(node[3], "f32") {
        cmp_type = "f32"
    } elif can_gen_unboxed(node[2], "bool") and can_gen_unboxed(node[3], "bool") {
        cmp_type = "bool"
    }
    
    var op = node[1]
    var left = gen_unboxed_expr(node[2], cmp_type)
    var right = gen_unboxed_expr(node[3], cmp_type)
    var res = "%cmp_i1_" + str(temp_count[0])
    temp_count[0] = temp_count[0] + 1
    var llvm_t = get_llvm_type(cmp_type)
    
    if cmp_type == "f32" or cmp_type == "f64" {
        var cond_op = "oeq"
        if op == "!=" {
            cond_op = "one"
        } elif op == "<" {
            cond_op = "olt"
        } elif op == "<=" {
            cond_op = "ole"
        } elif op == ">" {
            cond_op = "ogt"
        } elif op == ">=" {
            cond_op = "oge"
        }
        emit_inst(res + " = fcmp " + cond_op + " " + llvm_t + " " + left + ", " + right)
        return res
    }
    if cmp_type == "u8" {
        var cond_op = "eq"
        if op == "!=" {
            cond_op = "ne"
        } elif op == "<" {
            cond_op = "ult"
        } elif op == "<=" {
            cond_op = "ule"
        } elif op == ">" {
            cond_op = "ugt"
        } elif op == ">=" {
            cond_op = "uge"
        }
        emit_inst(res + " = icmp " + cond_op + " i8 " + left + ", " + right)
        return res
    }
    var cond_op = "eq"
    if op == "!=" {
        cond_op = "ne"
    } elif op == "<" {
        cond_op = "slt"
    } elif op == "<=" {
        cond_op = "sle"
    } elif op == ">" {
        cond_op = "sgt"
    } elif op == ">=" {
        cond_op = "sge"
    }
    emit_inst(res + " = icmp " + cond_op + " " + llvm_t + " " + left + ", " + right)
    return res
}

fn can_gen_i32(node) { return can_gen_unboxed(node, "i32") }
fn gen_i32_expr(node) { return gen_unboxed_expr(node, "i32") }
fn can_gen_i32_cmp(node) { return can_gen_static_cmp(node) }
fn gen_i32_cmp(node) { return gen_static_cmp(node) }
fn can_gen_double(node) { return can_gen_unboxed(node, "f64") }
fn gen_double_expr(node) { return gen_unboxed_expr(node, "f64") }

fn get_var_type(name) {
    var l = len(current_local_types)
    var i = 0
    repeat {
        if i >= l { break }
        var pair = current_local_types[i]
        if pair[0] == name {
            return pair[1]
        }
        i = i + 1
    } til i >= l
    return "Dynamic"
}

fn set_var_type(name, type) {
    var l = len(current_local_types)
    var i = 0
    repeat {
        if i >= l { break }
        var pair = current_local_types[i]
        if pair[0] == name {
            pair[1] = type
            return
        }
        i = i + 1
    } til i >= l
    append(current_local_types, [name, type])
}

fn infer_expr_type_in_scope(expr) {
    if not is_array(expr) { return "Dynamic" }
    var n_type = expr[0]
    if n_type == "Number" {
        if not has_dot(expr[1]) {
            return "i32"
        }
        return "f64"
    }
    if n_type == "Boolean" {
        return "bool"
    }
    if n_type == "Identifier" {
        return get_var_type(expr[1])
    }
    if n_type == "BinaryOp" {
        var op = expr[1]
        if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=" or op == "and" or op == "or" or op == "&&" or op == "||" {
            return "bool"
        }
        if op == "+" or op == "-" or op == "*" or op == "/" or op == "%" {
            var left_t = canonical_type(infer_expr_type_in_scope(expr[2]))
            var right_t = canonical_type(infer_expr_type_in_scope(expr[3]))
            if left_t == right_t and is_unboxed_type(left_t) {
                return left_t
            }
            if left_t == "f64" or right_t == "f64" { return "f64" }
            if left_t == "f32" or right_t == "f32" { return "f32" }
            if left_t == "i64" or right_t == "i64" { return "i64" }
            if left_t == "i32" or right_t == "i32" { return "i32" }
            if left_t == "u8" or right_t == "u8" { return "u8" }
        }
        return "Dynamic"
    }
    if n_type == "UnaryOp" {
        var op = expr[1]
        if op == "!" or op == "not" { return "bool" }
        if op == "-" {
            var sub_t = infer_expr_type_in_scope(expr[2])
            if is_unboxed_type(sub_t) { return sub_t }
        }
        return "Dynamic"
    }
    return "Dynamic"
}

fn scan_stmt_types(stmt) {
    if not is_array(stmt) { return; }
    var n_type = stmt[0]
    if n_type == "VarDecl" {
        var name = stmt[2]
        var val = stmt[3]
        var explicit_t = ""
        if len(stmt) > 4 { explicit_t = stmt[4] }
        if is_unboxed_type(explicit_t) {
            set_var_type(name, canonical_type(explicit_t))
        } else {
            var val_type = infer_expr_type_in_scope(val)
            set_var_type(name, val_type)
        }
    } elif n_type == "Assign" {
        var name = stmt[1]
        var val = stmt[2]
        var current_type = get_var_type(name)
        if not is_unboxed_type(current_type) {
            var val_type = infer_expr_type_in_scope(val)
            if current_type != val_type {
                set_var_type(name, "Dynamic")
            }
        }
    } elif n_type == "Repeat" {
        var body = stmt[1]
        var bl = len(body)
        var j = 0
        repeat {
            if j >= bl { break }
            scan_stmt_types(body[j])
            j = j + 1
        } til j >= bl
    } elif n_type == "If" {
        var then_body = stmt[2]
        var bl = len(then_body)
        var j = 0
        repeat {
            if j >= bl { break }
            scan_stmt_types(then_body[j])
            j = j + 1
        } til j >= bl
        
        var elif_clauses = stmt[3]
        var ecl = len(elif_clauses)
        var i = 0
        repeat {
            if i >= ecl { break }
            var clause = elif_clauses[i]
            var elif_body = clause[1]
            var ebl = len(elif_body)
            j = 0
            repeat {
                if j >= ebl { break }
                scan_stmt_types(elif_body[j])
                j = j + 1
            } til j >= ebl
            i = i + 1
        } til i >= ecl
        
        var else_body = stmt[4]
        var elbl = len(else_body)
        j = 0
        repeat {
            if j >= elbl { break }
            scan_stmt_types(else_body[j])
            j = j + 1
        } til j >= elbl
    } elif n_type == "TryCatch" {
        var try_body = stmt[1]
        var tbl = len(try_body)
        var j = 0
        repeat {
            if j >= tbl { break }
            scan_stmt_types(try_body[j])
            j = j + 1
        } til j >= tbl
        
        var catch_body = stmt[3]
        var cbl = len(catch_body)
        j = 0
        repeat {
            if j >= cbl { break }
            scan_stmt_types(catch_body[j])
            j = j + 1
        } til j >= cbl
    } elif n_type == "Unsafe" {
        var u_body = stmt[1]
        var ubl = len(u_body)
        var j = 0
        repeat {
            if j >= ubl { break }
            scan_stmt_types(u_body[j])
            j = j + 1
        } til j >= ubl
    }
}

fn collect_globals_from_stmts(stmts) {
    if not is_array(stmts) { return }
    var i = 0
    var l = len(stmts)
    repeat {
        if i >= l { break }
        var stmt = stmts[i]
        if is_array(stmt) {
            var stype = stmt[0]
            if stype == "VarDecl" {
                var name = stmt[2]
                if not contains_val(declared_globals[0], name) {
                    append(declared_globals[0], name)
                }
            } elif stype == "Arena" {
                var name = stmt[1]
                if not contains_val(declared_globals[0], name) {
                    append(declared_globals[0], name)
                }
            } elif stype == "Repeat" {
                collect_globals_from_stmts(stmt[1])
            } elif stype == "If" {
                collect_globals_from_stmts(stmt[2])
                var elif_clauses = stmt[3]
                var el = len(elif_clauses)
                var j = 0
                repeat {
                    if j >= el { break }
                    var clause = elif_clauses[j]
                    collect_globals_from_stmts(clause[1])
                    j = j + 1
                } til j >= el
                collect_globals_from_stmts(stmt[4])
            } elif stype == "TryCatch" {
                collect_globals_from_stmts(stmt[1])
                collect_globals_from_stmts(stmt[3])
            } elif stype == "Unsafe" {
                collect_globals_from_stmts(stmt[1])
            }
        }
        i = i + 1
    } til i >= l
}

fn analyze_scope_types(body, params) {
    current_local_types = []
    
    // 1. Add parameters as Dynamic
    var i = 0
    var pl = len(params)
    repeat {
        if i >= pl { break }
        append(current_local_types, [params[i], "Dynamic"])
        i = i + 1
    } til i >= pl
    
    // 2. Scan body statements
    var bl = len(body)
    i = 0
    repeat {
        if i >= bl { break }
        scan_stmt_types(body[i])
        i = i + 1
    } til i >= bl
}

fn gen_temp() {
    temp_count[0] = temp_count[0] + 1
    var name = "%tmp_" + str(temp_count[0])
    if in_function[0] {
        append(g_allocas[0], "  " + name + " = alloca %struct.Value, align 8")
    } else {
        append(g_main_allocas[0], "  " + name + " = alloca %struct.Value, align 8")
    }
    return name
}

fn emit_inst(inst) {
    if in_function[0] {
        append(g_insts[0], "  " + inst)
    } else {
        append(g_llvm_main, "  " + inst)
    }
}

fn llvm_escape_string(s) {
    var res = ""
    var i = 0
    var l = len(s)
    repeat {
        if i >= l { break }
        var c = char_at(s, i)
        if c == "\n" {
            res = res + "\\0A"
        } elif c == "\t" {
            res = res + "\\09"
        } elif c == "\r" {
            res = res + "\\0D"
        } elif c == "\\" {
            res = res + "\\5C"
        } elif c == "\"" {
            res = res + "\\22"
        } else {
            res = res + c
        }
        i = i + 1
    } til i >= l
    return res
}

fn push_scope() {
    append(g_scopes[0], [[], [], []])
}

fn pop_scope() {
    var scopes_list = g_scopes[0]
    var scope_idx = len(scopes_list) - 1
    var scope = scopes_list[scope_idx]
    var arenas = scope[0]
    var mallocs = scope[1]
    var owned_vars = scope[2]
    
    // Cleanup owned variables
    var oi = 0
    var ol = len(owned_vars)
    repeat {
        if oi >= ol { break }
        var ov = owned_vars[oi]
        var vt = canonical_type(get_var_type(ov))
        if not is_unboxed_type(vt) {
            emit_inst("call void @llvm_val_drop(ptr %wyrm_var_" + ov + ")")
        }
        oi = oi + 1
    } til oi >= ol

    // Cleanup mallocs
    var j = 0
    var ml = len(mallocs)
    repeat {
        if j >= ml { break }
        var m = mallocs[j]
        var t = gen_temp()
        emit_inst("call void @llvm_val_raw_free(ptr " + t + ", ptr %wyrm_var_" + m + ")")
        j = j + 1
    } til j >= ml

    // Cleanup arenas
    var k = 0
    var al = len(arenas)
    repeat {
        if k >= al { break }
        var a = arenas[k]
        emit_inst("call void @arena_destroy(ptr %wyrm_arena_" + a + ")")
        k = k + 1
    } til k >= al
    
    pop(g_scopes[0])
}

fn gen_all_cleanups() {
    var scopes_list = g_scopes[0]
    var i = len(scopes_list) - 1
    repeat {
        if i < 0 { break }
        var scope = scopes_list[i]
        var arenas = scope[0]
        var mallocs = scope[1]
        var owned_vars = scope[2]
        
        // Cleanup owned variables
        var oi = 0
        var ol = len(owned_vars)
        repeat {
            if oi >= ol { break }
            var ov = owned_vars[oi]
            var vt = canonical_type(get_var_type(ov))
            if not is_unboxed_type(vt) {
                emit_inst("call void @llvm_val_drop(ptr %wyrm_var_" + ov + ")")
            }
            oi = oi + 1
        } til oi >= ol

        var j = 0
        var ml = len(mallocs)
        repeat {
            if j >= ml { break }
            var m = mallocs[j]
            var t = gen_temp()
            emit_inst("call void @llvm_val_raw_free(ptr " + t + ", ptr %wyrm_var_" + m + ")")
            j = j + 1
        } til j >= ml

        var k = 0
        var al = len(arenas)
        repeat {
            if k >= al { break }
            var a = arenas[k]
            emit_inst("call void @arena_destroy(ptr %wyrm_arena_" + a + ")")
            k = k + 1
        } til k >= al
        
        i = i - 1
    } til i < 0
}

fn get_llvm_str_constant(s) {
    var str_idx = len(g_llvm_globals)
    var str_name = "@.str." + str(str_idx)
    var escaped = llvm_escape_string(s)
    var str_len = len(s) + 1
    append(g_llvm_globals, str_name + " = private unnamed_addr constant [" + str(str_len) + " x i8] c\"" + escaped + "\\00\", align 1")
    return str_name
}

fn gen_expr(node) {
    if node == null {
        var t = gen_temp()
        emit_inst("call void @llvm_val_null(ptr " + t + ")")
        return t
    }
    var type = node[0]
    if type == "Number" {
        var t = gen_temp()
        var val = node[1]
        if not has_dot(val) {
            val = val + ".0"
        }
        emit_inst("call void @llvm_val_number(ptr " + t + ", double " + val + ")")
        return t
    }
    if type == "String" {
        var t = gen_temp()
        var str_name = get_llvm_str_constant(node[1])
        emit_inst("call void @llvm_val_string(ptr " + t + ", ptr " + str_name + ")")
        return t
    }
    if type == "Boolean" {
        var t = gen_temp()
        var val_bit = "0"
        if node[1] == "true" { val_bit = "1" }
        emit_inst("call void @llvm_val_bool(ptr " + t + ", i1 " + val_bit + ")")
        return t
    }
    if type == "None" {
        var t = gen_temp()
        emit_inst("call void @llvm_val_null(ptr " + t + ")")
        return t
    }
    if type == "TryExpr" {
        var sub_expr = node[1]
        var reg = gen_expr(sub_expr)
        
        var type_ptr = "%type_ptr_" + str(temp_count[0])
        var type_val = "%type_val_" + str(temp_count[0])
        var is_err = "%is_err_" + str(temp_count[0])
        temp_count[0] = temp_count[0] + 1
        
        emit_inst(type_ptr + " = getelementptr %struct.Value, ptr " + reg + ", i32 0, i32 0")
        emit_inst(type_val + " = load i32, ptr " + type_ptr + ", align 4")
        emit_inst(is_err + " = icmp eq i32 " + type_val + ", 6")
        
        var label_idx = temp_count[0]
        temp_count[0] = temp_count[0] + 1
        var err_branch = "try_err_" + str(label_idx)
        var ok_branch = "try_ok_" + str(label_idx)
        
        emit_inst("br i1 " + is_err + ", label %" + err_branch + ", label %" + ok_branch)
        
        emit_label(err_branch + ":")
        var active_labels = g_catch_labels[0]
        var num_labels = len(active_labels)
        if num_labels > 0 {
            var catch_vars_list = g_catch_vars[0]
            var active_var = catch_vars_list[num_labels - 1]
            emit_inst("call void @llvm_val_copy(ptr " + active_var + ", ptr " + reg + ")")
            var active_label = active_labels[num_labels - 1]
            emit_inst("br label %" + active_label)
        } else {
            emit_inst("call void @llvm_val_copy(ptr %result_ptr, ptr " + reg + ")")
            gen_all_cleanups()
            emit_inst("ret void")
        }
        
        emit_label(ok_branch + ":")
        return reg
    }
    if type == "CatchExpr" {
        var sub_expr = node[1]
        var fallback_expr = node[2]
        
        var res_var = gen_temp()
        var reg = gen_expr(sub_expr)
        
        var type_ptr = "%type_ptr_" + str(temp_count[0])
        var type_val = "%type_val_" + str(temp_count[0])
        var is_err = "%is_err_" + str(temp_count[0])
        temp_count[0] = temp_count[0] + 1
        
        emit_inst(type_ptr + " = getelementptr %struct.Value, ptr " + reg + ", i32 0, i32 0")
        emit_inst(type_val + " = load i32, ptr " + type_ptr + ", align 4")
        emit_inst(is_err + " = icmp eq i32 " + type_val + ", 6")
        
        var label_idx = temp_count[0]
        temp_count[0] = temp_count[0] + 1
        var err_branch = "catch_err_" + str(label_idx)
        var ok_branch = "catch_ok_" + str(label_idx)
        var merge_branch = "catch_merge_" + str(label_idx)
        
        emit_inst("br i1 " + is_err + ", label %" + err_branch + ", label %" + ok_branch)
        
        emit_label(err_branch + ":")
        var fallback_reg = gen_expr(fallback_expr)
        emit_inst("call void @llvm_val_copy(ptr " + res_var + ", ptr " + fallback_reg + ")")
        emit_inst("br label %" + merge_branch)
        
        emit_label(ok_branch + ":")
        emit_inst("call void @llvm_val_copy(ptr " + res_var + ", ptr " + reg + ")")
        emit_inst("br label %" + merge_branch)
        
        emit_label(merge_branch + ":")
        return res_var
    }
    if type == "Identifier" {
        var name = node[1]
        var v_type = canonical_type(get_var_type(name))
        if is_unboxed_type(v_type) {
            var t = gen_temp()
            var llvm_t = get_llvm_type(v_type)
            var llvm_a = get_llvm_align(v_type)
            var raw_val = "%raw_val_" + str(temp_count[0])
            temp_count[0] = temp_count[0] + 1
            if contains_val(declared_globals[0], name) {
                emit_inst(raw_val + " = load " + llvm_t + ", ptr @wyrm_var_" + name + ", align " + llvm_a)
            } else {
                emit_inst(raw_val + " = load " + llvm_t + ", ptr %wyrm_var_" + name + ", align " + llvm_a)
            }
            if v_type == "i32" {
                var dbl_conv = "%dbl_conv_" + str(temp_count[0])
                temp_count[0] = temp_count[0] + 1
                emit_inst(dbl_conv + " = sitofp i32 " + raw_val + " to double")
                emit_inst("call void @llvm_val_number(ptr " + t + ", double " + dbl_conv + ")")
                return t
            }
            if v_type == "i64" {
                emit_inst("call void @llvm_val_from_i64(ptr " + t + ", i64 " + raw_val + ")")
                return t
            }
            if v_type == "u8" {
                emit_inst("call void @llvm_val_from_u8(ptr " + t + ", i8 " + raw_val + ")")
                return t
            }
            if v_type == "f32" {
                emit_inst("call void @llvm_val_from_f32(ptr " + t + ", float " + raw_val + ")")
                return t
            }
            if v_type == "f64" {
                emit_inst("call void @llvm_val_number(ptr " + t + ", double " + raw_val + ")")
                return t
            }
            if v_type == "bool" {
                emit_inst("call void @llvm_val_from_bool(ptr " + t + ", i1 " + raw_val + ")")
                return t
            }
        }
        if contains_val(declared_globals[0], name) or not in_function[0] {
            return "@wyrm_var_" + name
        }
        return "%wyrm_var_" + name
    }
    if type == "BinaryOp" {
        var op = node[1]
        if op == "+" or op == "-" or op == "*" or op == "/" or op == "%" {
            if can_gen_unboxed(node, "i32") {
                var i32_res = gen_unboxed_expr(node, "i32")
                var dbl_conv = "%dbl_conv_" + str(temp_count[0])
                temp_count[0] = temp_count[0] + 1
                emit_inst(dbl_conv + " = sitofp i32 " + i32_res + " to double")
                var t = gen_temp()
                emit_inst("call void @llvm_val_number(ptr " + t + ", double " + dbl_conv + ")")
                return t
            }
            if can_gen_unboxed(node, "i64") {
                var i64_res = gen_unboxed_expr(node, "i64")
                var t = gen_temp()
                emit_inst("call void @llvm_val_from_i64(ptr " + t + ", i64 " + i64_res + ")")
                return t
            }
            if can_gen_unboxed(node, "u8") {
                var u8_res = gen_unboxed_expr(node, "u8")
                var t = gen_temp()
                emit_inst("call void @llvm_val_from_u8(ptr " + t + ", i8 " + u8_res + ")")
                return t
            }
            if can_gen_unboxed(node, "f32") {
                var f32_res = gen_unboxed_expr(node, "f32")
                var t = gen_temp()
                emit_inst("call void @llvm_val_from_f32(ptr " + t + ", float " + f32_res + ")")
                return t
            }
            if can_gen_unboxed(node, "f64") {
                var dbl_res = gen_unboxed_expr(node, "f64")
                var t = gen_temp()
                emit_inst("call void @llvm_val_number(ptr " + t + ", double " + dbl_res + ")")
                return t
            }
        }
        var t = gen_temp()
        var left_reg = gen_expr(node[2])
        var right_reg = gen_expr(node[3])
        var func = ""
        if op == "+" {
            func = "llvm_val_add"
        } elif op == "-" {
            func = "llvm_val_sub"
        } elif op == "*" {
            func = "llvm_val_mul"
        } elif op == "/" {
            func = "llvm_val_div"
        } elif op == "%" {
            func = "llvm_val_mod"
        } elif op == "//" {
            func = "llvm_val_floordiv"
        } elif op == "==" {
            func = "llvm_val_eq"
        } elif op == "!=" {
            func = "llvm_val_ne"
        } elif op == "<" {
            func = "llvm_val_lt"
        } elif op == ">" {
            func = "llvm_val_gt"
        } elif op == "<=" {
            func = "llvm_val_le"
        } elif op == ">=" {
            func = "llvm_val_ge"
        } elif op == "and" or op == "&&" {
            func = "llvm_val_and"
        } elif op == "or" or op == "||" {
            func = "llvm_val_or"
        } elif op == "**" {
            func = "llvm_val_pow"
        }
        
        emit_inst("call void @" + func + "(ptr " + t + ", ptr " + left_reg + ", ptr " + right_reg + ")")
        return t
    }
    if type == "UnaryOp" {
        var op = node[1]
        if op == "-" and can_gen_double(node) {
            var dbl_res = gen_double_expr(node)
            var t = gen_temp()
            emit_inst("call void @llvm_val_number(ptr " + t + ", double " + dbl_res + ")")
            return t
        }
        var t = gen_temp()
        var expr_reg = gen_expr(node[2])
        if op == "-" {
            var zero_reg = gen_temp()
            emit_inst("call void @llvm_val_number(ptr " + zero_reg + ", double 0.0)")
            emit_inst("call void @llvm_val_sub(ptr " + t + ", ptr " + zero_reg + ", ptr " + expr_reg + ")")
        } elif op == "!" or op == "not" {
            emit_inst("call void @llvm_val_not(ptr " + t + ", ptr " + expr_reg + ")")
        }
        return t
    }
    if type == "List" {
        var t = gen_temp()
        var elems = node[1]
        var num_elems = len(elems)
        emit_inst("call void @llvm_val_array_create(ptr " + t + ", i32 " + str(num_elems) + ")")
        var i = 0
        repeat {
            if i >= num_elems { break }
            var elem_reg = gen_expr(elems[i])
            var idx_reg = gen_temp()
            emit_inst("call void @llvm_val_number(ptr " + idx_reg + ", double " + str(i) + ".0)")
            emit_inst("call void @llvm_val_array_set(ptr " + t + ", ptr " + idx_reg + ", ptr " + elem_reg + ")")
            i = i + 1
        } til i >= num_elems
        return t
    }
    if type == "Index" {
        var t = gen_temp()
        var obj_reg = gen_expr(node[1])
        var idx_node = node[2]
        if idx_node[0] == "Slice" {
            var start_reg = gen_expr(idx_node[1])
            var end_reg = gen_expr(idx_node[2])
            emit_inst("call void @llvm_val_array_slice(ptr " + t + ", ptr " + obj_reg + ", ptr " + start_reg + ", ptr " + end_reg + ")")
        } else {
            var idx_reg = gen_expr(idx_node)
            emit_inst("call void @llvm_val_array_get(ptr " + t + ", ptr " + obj_reg + ", ptr " + idx_reg + ")")
        }
        return t
    }
    if type == "ArenaAlloc" {
        var t = gen_temp()
        var size_reg = gen_expr(node[2])
        var arena_name = node[1]
        emit_inst("call void @llvm_val_arena_alloc(ptr " + t + ", ptr %wyrm_arena_" + arena_name + ", ptr " + size_reg + ")")
        return t
    }
    if type == "ArenaReset" {
        var t = gen_temp()
        var arena_name = node[1]
        emit_inst("call void @llvm_val_arena_reset(ptr " + t + ", ptr %wyrm_arena_" + arena_name + ")")
        return t
    }
    if type == "FuncCall" {
        var name_node = node[1]
        var name = name_node[1]
        var args = node[2]
        var num_args = len(args)
        
        var arg_regs = []
        var i = 0
        repeat {
            if i >= num_args { break }
            append(arg_regs, gen_expr(args[i]))
            i = i + 1
        } til i >= num_args

        var t = gen_temp()

        // Check if builtin
        var is_builtin = false
        var builtin_func = ""
        if name == "len" {
            builtin_func = "llvm_val_len"
            is_builtin = true
        } elif name == "type" {
            builtin_func = "llvm_val_type"
            is_builtin = true
        } elif name == "int" {
            builtin_func = "llvm_val_int"
            is_builtin = true
        } elif name == "float" {
            builtin_func = "llvm_val_float"
            is_builtin = true
        } elif name == "str" {
            builtin_func = "llvm_val_str"
            is_builtin = true
        } elif name == "abs" {
            builtin_func = "llvm_val_abs"
            is_builtin = true
        } elif name == "round" {
            builtin_func = "llvm_val_round"
            is_builtin = true
        } elif name == "pow" {
            builtin_func = "llvm_val_pow"
            is_builtin = true
        } elif name == "append" {
            builtin_func = "llvm_val_array_append"
            is_builtin = true
        } elif name == "pop" {
            builtin_func = "llvm_val_array_pop"
            is_builtin = true
        } elif name == "malloc" {
            builtin_func = "llvm_val_raw_malloc"
            is_builtin = true
        } elif name == "free" {
            builtin_func = "llvm_val_raw_free"
            is_builtin = true
        } elif name == "realloc" {
            builtin_func = "llvm_val_raw_realloc"
            is_builtin = true
        } elif name == "sys_args" {
            builtin_func = "val_sys_args"
            is_builtin = true
        } elif name == "read_file" {
            builtin_func = "llvm_val_read_file"
            is_builtin = true
        } elif name == "error" {
            builtin_func = "llvm_val_error_val"
            is_builtin = true
        } elif name == "write_file" {
            builtin_func = "llvm_val_write_file"
            is_builtin = true
        } elif name == "exit" {
            builtin_func = "llvm_val_exit"
            is_builtin = true
        } elif name == "system" {
            builtin_func = "llvm_val_system"
            is_builtin = true
        } elif name == "getenv" {
            builtin_func = "llvm_val_getenv"
            is_builtin = true
        } elif name == "split" {
            builtin_func = "llvm_val_split"
            is_builtin = true
        } elif name == "join" {
            builtin_func = "llvm_val_join"
            is_builtin = true
        } elif name == "trim" {
            builtin_func = "llvm_val_trim"
            is_builtin = true
        } elif name == "upper" {
            builtin_func = "llvm_val_upper"
            is_builtin = true
        } elif name == "lower" {
            builtin_func = "llvm_val_lower"
            is_builtin = true
        } elif name == "contains" {
            builtin_func = "llvm_val_contains"
            is_builtin = true
        } elif name == "replace" {
            builtin_func = "llvm_val_replace"
            is_builtin = true
        } elif name == "starts_with" {
            builtin_func = "llvm_val_starts_with"
            is_builtin = true
        } elif name == "ends_with" {
            builtin_func = "llvm_val_ends_with"
            is_builtin = true
        } elif name == "char_at" {
            builtin_func = "llvm_val_char_at"
            is_builtin = true
        } elif name == "ord_val" {
            builtin_func = "llvm_val_ord_val"
            is_builtin = true
        } elif name == "chr_val" {
            builtin_func = "llvm_val_chr_val"
            is_builtin = true
        } elif name == "to_bytes" {
            builtin_func = "llvm_val_to_bytes"
            is_builtin = true
        } elif name == "from_bytes" {
            builtin_func = "llvm_val_from_bytes"
            is_builtin = true
        } elif name == "json_parse" {
            builtin_func = "llvm_val_json_parse"
            is_builtin = true
        } elif name == "json_encode" {
            builtin_func = "llvm_val_json_encode"
            is_builtin = true
        } elif name == "json_pretty" {
            builtin_func = "llvm_val_json_pretty"
            is_builtin = true
        } elif name == "json_get" {
            builtin_func = "llvm_val_json_get"
            is_builtin = true
        } elif name == "json_has" {
            builtin_func = "llvm_val_json_has"
            is_builtin = true
        } elif name == "json_set" {
            builtin_func = "llvm_val_json_set"
            is_builtin = true
        } elif name == "json_object" {
            builtin_func = "llvm_val_json_object"
            is_builtin = true
        } elif name == "yaml_parse" {
            builtin_func = "llvm_val_yaml_parse"
            is_builtin = true
        } elif name == "yaml_encode" {
            builtin_func = "llvm_val_yaml_encode"
            is_builtin = true
        } elif name == "map_new" {
            builtin_func = "llvm_val_map_new"
            is_builtin = true
        } elif name == "map_set" {
            builtin_func = "llvm_val_map_set"
            is_builtin = true
        } elif name == "map_get" {
            builtin_func = "llvm_val_map_get"
            is_builtin = true
        } elif name == "map_has" {
            builtin_func = "llvm_val_map_has"
            is_builtin = true
        } elif name == "map_del" {
            builtin_func = "llvm_val_map_del"
            is_builtin = true
        } elif name == "map_keys" {
            builtin_func = "llvm_val_map_keys"
            is_builtin = true
        } elif name == "map_values" {
            builtin_func = "llvm_val_map_values"
            is_builtin = true
        } elif name == "map_len" {
            builtin_func = "llvm_val_map_len"
            is_builtin = true
        } elif name == "set_new" {
            builtin_func = "llvm_val_set_new"
            is_builtin = true
        } elif name == "set_add" {
            builtin_func = "llvm_val_set_add"
            is_builtin = true
        } elif name == "set_has" {
            builtin_func = "llvm_val_set_has"
            is_builtin = true
        } elif name == "set_del" {
            builtin_func = "llvm_val_set_del"
            is_builtin = true
        } elif name == "set_union" {
            builtin_func = "llvm_val_set_union"
            is_builtin = true
        } elif name == "set_intersect" {
            builtin_func = "llvm_val_set_intersect"
            is_builtin = true
        } elif name == "set_to_array" {
            builtin_func = "llvm_val_set_to_array"
            is_builtin = true
        } elif name == "sdl_init" {
            builtin_func = "llvm_val_sdl_init"
            is_builtin = true
        } elif name == "sdl_quit" {
            builtin_func = "llvm_val_sdl_quit"
            is_builtin = true
        } elif name == "sdl_window" {
            builtin_func = "llvm_val_sdl_window"
            is_builtin = true
        } elif name == "sdl_destroy_window" {
            builtin_func = "llvm_val_sdl_destroy_window"
            is_builtin = true
        } elif name == "sdl_poll_event" {
            builtin_func = "llvm_val_sdl_poll_event"
            is_builtin = true
        } elif name == "sdl_clear" {
            builtin_func = "llvm_val_sdl_clear"
            is_builtin = true
        } elif name == "sdl_present" {
            builtin_func = "llvm_val_sdl_present"
            is_builtin = true
        } elif name == "sdl_draw_rect" {
            builtin_func = "llvm_val_sdl_draw_rect"
            is_builtin = true
        } elif name == "sdl_draw_line" {
            builtin_func = "llvm_val_sdl_draw_line"
            is_builtin = true
        } elif name == "sdl_delay" {
            builtin_func = "llvm_val_sdl_delay"
            is_builtin = true
        } elif name == "sdl_ticks" {
            builtin_func = "llvm_val_sdl_ticks"
            is_builtin = true
        } elif name == "ffi_open" {
            builtin_func = "llvm_val_ffi_open"
            is_builtin = true
        } elif name == "ffi_sym" {
            builtin_func = "llvm_val_ffi_sym"
            is_builtin = true
        } elif name == "ffi_call" {
            builtin_func = "llvm_val_ffi_call"
            is_builtin = true
        } elif name == "ffi_close" {
            builtin_func = "llvm_val_ffi_close"
            is_builtin = true
        }
        
        if is_builtin {
            if name == "sys_args" {
                emit_inst("call void @llvm_val_copy(ptr " + t + ", ptr @wyrm_sys_args)")
            } else {
                var call_args = "ptr " + t
                var j = 0
                repeat {
                    if j >= num_args { break }
                    call_args = call_args + ", ptr " + arg_regs[j]
                    j = j + 1
                } til j >= num_args
                emit_inst("call void @" + builtin_func + "(" + call_args + ")")
            }
        } else {
            var call_args = "ptr " + t
            var j = 0
            repeat {
                if j >= num_args { break }
                call_args = call_args + ", ptr " + arg_regs[j]
                j = j + 1
            } til j >= num_args
            emit_inst("call void @wyrm_fn_" + name + "(" + call_args + ")")
        }
        return t
    }
    if type == "MemberAccess" {
        var obj_node = node[1]
        var member = node[2]
        var obj_reg = gen_expr(obj_node)
        var member_const = get_llvm_str_constant(member)
        var t = gen_temp()
        emit_inst("call void @llvm_val_struct_get(ptr " + t + ", ptr " + obj_reg + ", ptr " + member_const + ")")
        return t
    }
    if type == "MethodCall" {
        var obj_node = node[1]
        var method = node[2]
        var args = node[3]
        var obj_reg = gen_expr(obj_node)
        var num_args = len(args)
        var arg_regs = []
        var i = 0
        repeat {
            if i >= num_args { break }
            append(arg_regs, gen_expr(args[i]))
            i = i + 1
        } til i >= num_args
        var t = gen_temp()
        var call_args = "ptr " + t + ", ptr " + obj_reg
        var j = 0
        repeat {
            if j >= num_args { break }
            call_args = call_args + ", ptr " + arg_regs[j]
            j = j + 1
        } til j >= num_args
        emit_inst("call void @wyrm_fn_" + method + "(" + call_args + ")")
        return t
    }
    
    print("Code Generator Error: Unknown expression type '" + type + "'")
    exit(1)
}

fn gen_statement(stmt) {
    var type = stmt[0]
    if type == "Use" {
        return
    }
    if type == "MemberAssign" {
        var obj_node = stmt[1]
        var member = stmt[2]
        var val = stmt[3]
        var obj_reg = gen_expr(obj_node)
        var val_reg = gen_expr(val)
        var member_const = get_llvm_str_constant(member)
        emit_inst("call void @llvm_val_struct_set(ptr " + obj_reg + ", ptr " + member_const + ", ptr " + val_reg + ")")
        return
    }
    if type == "StructDef" {
        var s_name = stmt[1]
        var fields = stmt[2]
        var methods = stmt[3]
        
        var num_f = len(fields)
        var params_decl = "ptr %result_ptr"
        var i = 0
        repeat {
            if i >= num_f { break }
            var f_info = fields[i]
            var f_name = f_info
            if is_array(f_info) {
                f_name = f_info[0]
            }
            params_decl = params_decl + ", ptr %arg_" + f_name
            i = i + 1
        } til i >= num_f
        
        var ctor_code = "define void @wyrm_fn_" + s_name + "(" + params_decl + ") {\n"
        ctor_code = ctor_code + "  %s_ptr = alloca %struct.Value, align 8\n"
        var s_name_const = get_llvm_str_constant(s_name)
        ctor_code = ctor_code + "  call void @llvm_val_struct_create(ptr %s_ptr, ptr " + s_name_const + ", i32 " + str(num_f) + ")\n"
        i = 0
        repeat {
            if i >= num_f { break }
            var f_info = fields[i]
            var f_name = f_info
            if is_array(f_info) {
                f_name = f_info[0]
            }
            var f_const = get_llvm_str_constant(f_name)
            ctor_code = ctor_code + "  call void @llvm_val_struct_set(ptr %s_ptr, ptr " + f_const + ", ptr %arg_" + f_name + ")\n"
            i = i + 1
        } til i >= num_f
        ctor_code = ctor_code + "  call void @llvm_val_copy(ptr %result_ptr, ptr %s_ptr)\n"
        ctor_code = ctor_code + "  ret void\n}\n"
        append(g_llvm_funcs, ctor_code)
        
        var m_idx = 0
        var num_m = len(methods)
        repeat {
            if m_idx >= num_m { break }
            gen_statement(methods[m_idx])
            m_idx = m_idx + 1
        } til m_idx >= num_m
        return
    }
    if type == "FuncDef" {
        in_function[0] = true
        var name = stmt[1]
        var params = stmt[2]
        var body = stmt[3]
        
        var outer_types = current_local_types
        analyze_scope_types(body, params)
        
        g_allocas[0] = []
        g_insts[0] = []
        temp_count[0] = 0
        g_scopes[0] = []
        declared_locals[0] = []
        
        push_scope()
        
        // Copy parameters to local variables so they can be mutated
        var i = 0
        var num_params = len(params)
        var params_decl = "ptr %result_ptr"
        repeat {
            if i >= num_params { break }
            params_decl = params_decl + ", ptr %arg_" + params[i]
            i = i + 1
        } til i >= num_params

        i = 0
        repeat {
            if i >= num_params { break }
            var p_name = params[i]
            append(g_allocas[0], "  %wyrm_var_" + p_name + " = alloca %struct.Value, align 8")
            append(declared_locals[0], p_name)
            emit_inst("call void @llvm_val_copy(ptr %wyrm_var_" + p_name + ", ptr %arg_" + p_name + ")")
            i = i + 1
        } til i >= num_params

        // Generate function body
        var j = 0
        var body_len = len(body)
        repeat {
            if j >= body_len { break }
            gen_statement(body[j])
            j = j + 1
        } til j >= body_len
        
        pop_scope()
        
        // Function signature
        var func_code = "define void @wyrm_fn_" + name + "(" + params_decl + ") {\n"
        // Merge allocas and insts
        var k = 0
        var allocas_list = g_allocas[0]
        var al = len(allocas_list)
        repeat {
            if k >= al { break }
            func_code = func_code + allocas_list[k] + "\n"
            k = k + 1
        } til k >= al
        
        k = 0
        var insts_list = g_insts[0]
        var il = len(insts_list)
        repeat {
            if k >= il { break }
            func_code = func_code + insts_list[k] + "\n"
            k = k + 1
        } til k >= il
        
        func_code = func_code + "  call void @llvm_val_null(ptr %result_ptr)\n"
        func_code = func_code + "  ret void\n"
        func_code = func_code + "}\n"
        append(g_llvm_funcs, func_code)
        
        in_function[0] = false
        current_local_types = outer_types
        return
    }
    if type == "VarDecl" {
        var decl_kind = stmt[1]
        var name = stmt[2]
        var val = stmt[3]
        var explicit_t = ""
        if len(stmt) > 4 { explicit_t = stmt[4] }
        var v_type = canonical_type(get_var_type(name))
        if explicit_t != "" {
            v_type = canonical_type(explicit_t)
            set_var_type(name, v_type)
        }
        
        // Track owned variables in active scope
        if decl_kind == "owned" {
            var scopes_list = g_scopes[0]
            if len(scopes_list) > 0 {
                var scope = scopes_list[len(scopes_list) - 1]
                append(scope[2], name)
            }
        }
        
        if is_unboxed_type(v_type) {
            var llvm_t = get_llvm_type(v_type)
            var llvm_a = get_llvm_align(v_type)
            var target_ptr = ""
            if in_function[0] {
                if not contains_val(declared_locals[0], name) {
                    append(g_allocas[0], "  %wyrm_var_" + name + " = alloca " + llvm_t + ", align " + llvm_a)
                    append(declared_locals[0], name)
                }
                target_ptr = "%wyrm_var_" + name
            } else {
                if not contains_val(emitted_globals[0], name) {
                    append(g_llvm_globals, "@wyrm_var_" + name + " = global " + llvm_t + " 0, align " + llvm_a)
                    append(emitted_globals[0], name)
                }
                target_ptr = "@wyrm_var_" + name
            }
            if can_gen_unboxed(val, v_type) {
                var val_reg = gen_unboxed_expr(val, v_type)
                emit_inst("store " + llvm_t + " " + val_reg + ", ptr " + target_ptr + ", align " + llvm_a)
            } else {
                var val_reg = gen_expr(val)
                var union_ptr = "%union_ptr_" + str(temp_count[0])
                var dbl_val = "%dbl_val_" + str(temp_count[0])
                temp_count[0] = temp_count[0] + 1
                emit_inst(union_ptr + " = getelementptr %struct.Value, ptr " + val_reg + ", i32 0, i32 1")
                emit_inst(dbl_val + " = load double, ptr " + union_ptr + ", align 8")
                if v_type == "i32" {
                    var i_val = "%i32_val_" + str(temp_count[0])
                    temp_count[0] = temp_count[0] + 1
                    emit_inst(i_val + " = fptosi double " + dbl_val + " to i32")
                    emit_inst("store i32 " + i_val + ", ptr " + target_ptr + ", align 4")
                } elif v_type == "i64" {
                    var i_val = "%i64_val_" + str(temp_count[0])
                    temp_count[0] = temp_count[0] + 1
                    emit_inst(i_val + " = fptosi double " + dbl_val + " to i64")
                    emit_inst("store i64 " + i_val + ", ptr " + target_ptr + ", align 8")
                } elif v_type == "u8" {
                    var i_val = "%u8_val_" + str(temp_count[0])
                    temp_count[0] = temp_count[0] + 1
                    emit_inst(i_val + " = fptoui double " + dbl_val + " to i8")
                    emit_inst("store i8 " + i_val + ", ptr " + target_ptr + ", align 1")
                } elif v_type == "f32" {
                    var f_val = "%f32_val_" + str(temp_count[0])
                    temp_count[0] = temp_count[0] + 1
                    emit_inst(f_val + " = fptrunc double " + dbl_val + " to float")
                    emit_inst("store float " + f_val + ", ptr " + target_ptr + ", align 4")
                } elif v_type == "bool" {
                    var b_val = "%b_val_" + str(temp_count[0])
                    temp_count[0] = temp_count[0] + 1
                    emit_inst(b_val + " = call i1 @llvm_val_to_bool(ptr " + val_reg + ")")
                    emit_inst("store i1 " + b_val + ", ptr " + target_ptr + ", align 1")
                } else {
                    emit_inst("store double " + dbl_val + ", ptr " + target_ptr + ", align 8")
                }
            }
            return
        }
        if in_function[0] {
            if not contains_val(declared_locals[0], name) {
                append(g_allocas[0], "  %wyrm_var_" + name + " = alloca %struct.Value, align 8")
                append(declared_locals[0], name)
            }
            var val_reg = gen_expr(val)
            emit_inst("call void @llvm_val_copy(ptr %wyrm_var_" + name + ", ptr " + val_reg + ")")
            
            // Check if malloc in unsafe block for cleanup tracking
            if in_unsafe[0] and val != null and val[0] == "FuncCall" {
                var call_func = val[1]
                var call_name = call_func[1]
                if call_name == "malloc" {
                    var scopes_list = g_scopes[0]
                    var scope_idx = len(scopes_list) - 1
                    var scope = scopes_list[scope_idx]
                    var mallocs = scope[1]
                    append(mallocs, name)
                }
            }
        } else {
            var val_reg = gen_expr(val)
            if not contains_val(emitted_globals[0], name) {
                append(g_llvm_globals, "@wyrm_var_" + name + " = global %struct.Value zeroinitializer, align 8")
                append(emitted_globals[0], name)
            }
            emit_inst("call void @llvm_val_copy(ptr @wyrm_var_" + name + ", ptr " + val_reg + ")")
        }
        return
    }
    if type == "Assign" {
        var name = stmt[1]
        var val = stmt[2]
        var v_type = canonical_type(get_var_type(name))
        var target_ptr = "%wyrm_var_" + name
        if contains_val(declared_globals[0], name) or not in_function[0] {
            target_ptr = "@wyrm_var_" + name
        }
        if is_unboxed_type(v_type) {
            var llvm_t = get_llvm_type(v_type)
            var llvm_a = get_llvm_align(v_type)
            if can_gen_unboxed(val, v_type) {
                var val_reg = gen_unboxed_expr(val, v_type)
                emit_inst("store " + llvm_t + " " + val_reg + ", ptr " + target_ptr + ", align " + llvm_a)
            } else {
                var val_reg = gen_expr(val)
                var union_ptr = "%union_ptr_" + str(temp_count[0])
                var dbl_val = "%dbl_val_" + str(temp_count[0])
                temp_count[0] = temp_count[0] + 1
                emit_inst(union_ptr + " = getelementptr %struct.Value, ptr " + val_reg + ", i32 0, i32 1")
                emit_inst(dbl_val + " = load double, ptr " + union_ptr + ", align 8")
                if v_type == "i32" {
                    var i_val = "%i32_val_" + str(temp_count[0])
                    temp_count[0] = temp_count[0] + 1
                    emit_inst(i_val + " = fptosi double " + dbl_val + " to i32")
                    emit_inst("store i32 " + i_val + ", ptr " + target_ptr + ", align 4")
                } elif v_type == "i64" {
                    var i_val = "%i64_val_" + str(temp_count[0])
                    temp_count[0] = temp_count[0] + 1
                    emit_inst(i_val + " = fptosi double " + dbl_val + " to i64")
                    emit_inst("store i64 " + i_val + ", ptr " + target_ptr + ", align 8")
                } elif v_type == "u8" {
                    var i_val = "%u8_val_" + str(temp_count[0])
                    temp_count[0] = temp_count[0] + 1
                    emit_inst(i_val + " = fptoui double " + dbl_val + " to i8")
                    emit_inst("store i8 " + i_val + ", ptr " + target_ptr + ", align 1")
                } elif v_type == "f32" {
                    var f_val = "%f32_val_" + str(temp_count[0])
                    temp_count[0] = temp_count[0] + 1
                    emit_inst(f_val + " = fptrunc double " + dbl_val + " to float")
                    emit_inst("store float " + f_val + ", ptr " + target_ptr + ", align 4")
                } elif v_type == "bool" {
                    var b_val = "%b_val_" + str(temp_count[0])
                    temp_count[0] = temp_count[0] + 1
                    emit_inst(b_val + " = call i1 @llvm_val_to_bool(ptr " + val_reg + ")")
                    emit_inst("store i1 " + b_val + ", ptr " + target_ptr + ", align 1")
                } else {
                    emit_inst("store double " + dbl_val + ", ptr " + target_ptr + ", align 8")
                }
            }
            return
        }
        var val_reg = gen_expr(val)
        emit_inst("call void @llvm_val_copy(ptr " + target_ptr + ", ptr " + val_reg + ")")
        return
    }
    if type == "IndexAssign" {
        var obj_reg = gen_expr(stmt[1])
        var idx_reg = gen_expr(stmt[2])
        var val_reg = gen_expr(stmt[3])
        emit_inst("call void @llvm_val_array_set(ptr " + obj_reg + ", ptr " + idx_reg + ", ptr " + val_reg + ")")
        return
    }
    if type == "Print" {
        var exprs = stmt[1]
        var num_exprs = len(exprs)
        var call_args = "i32 " + str(num_exprs)
        var i = 0
        repeat {
            if i >= num_exprs { break }
            var reg = gen_expr(exprs[i])
            call_args = call_args + ", ptr " + reg
            i = i + 1
        } til i >= num_exprs
        emit_inst("call void (i32, ...) @llvm_val_print(" + call_args + ")")
        return
    }
    if type == "If" {
        var cond = stmt[1]
        var then_body = stmt[2]
        var elif_clauses = stmt[3]
        var else_body = stmt[4]
        var num_elifs = len(elif_clauses)
        
        var cond_i1 = "%cond_i1_" + str(temp_count[0])
        temp_count[0] = temp_count[0] + 1
        if can_gen_static_cmp(cond) {
            cond_i1 = gen_static_cmp(cond)
        } else {
            var cond_reg = gen_expr(cond)
            emit_inst(cond_i1 + " = call i1 @llvm_val_to_bool(ptr " + cond_reg + ")")
        }
        
        var label_idx = temp_count[0]
        temp_count[0] = temp_count[0] + 1
        
        var then_label = "then_" + str(label_idx)
        var merge_label = "merge_" + str(label_idx)
        
        var first_false_label = merge_label
        if num_elifs > 0 {
            first_false_label = "elif_cond_" + str(label_idx) + "_0"
        } elif len(else_body) > 0 {
            first_false_label = "else_" + str(label_idx)
        }
        
        emit_inst("br i1 " + cond_i1 + ", label %" + then_label + ", label %" + first_false_label)
        
        // Then block
        emit_label(then_label + ":")
        push_scope()
        var i = 0
        var then_len = len(then_body)
        repeat {
            if i >= then_len { break }
            gen_statement(then_body[i])
            i = i + 1
        } til i >= then_len
        pop_scope()
        emit_inst("br label %" + merge_label)
        
        // Elif blocks
        i = 0
        repeat {
            if i >= num_elifs { break }
            var clause = elif_clauses[i]
            var elif_cond = clause[0]
            var elif_body = clause[1]
            
            var current_cond_label = "elif_cond_" + str(label_idx) + "_" + str(i)
            var current_then_label = "elif_then_" + str(label_idx) + "_" + str(i)
            
            var next_false_label = merge_label
            if i + 1 < num_elifs {
                next_false_label = "elif_cond_" + str(label_idx) + "_" + str(i + 1)
            } elif len(else_body) > 0 {
                next_false_label = "else_" + str(label_idx)
            }
            
            emit_label(current_cond_label + ":")
            var current_cond_i1 = "%cond_i1_" + str(temp_count[0])
            temp_count[0] = temp_count[0] + 1
            if can_gen_static_cmp(elif_cond) {
                current_cond_i1 = gen_static_cmp(elif_cond)
            } else {
                var current_cond_reg = gen_expr(elif_cond)
                emit_inst(current_cond_i1 + " = call i1 @llvm_val_to_bool(ptr " + current_cond_reg + ")")
            }
            emit_inst("br i1 " + current_cond_i1 + ", label %" + current_then_label + ", label %" + next_false_label)
            
            emit_label(current_then_label + ":")
            push_scope()
            var j = 0
            var elif_len = len(elif_body)
            repeat {
                if j >= elif_len { break }
                gen_statement(elif_body[j])
                j = j + 1
            } til j >= elif_len
            pop_scope()
            emit_inst("br label %" + merge_label)
            
            i = i + 1
        } til i >= num_elifs
        
        // Else block
        if len(else_body) > 0 {
            var else_label = "else_" + str(label_idx)
            emit_label(else_label + ":")
            push_scope()
            i = 0
            var else_len = len(else_body)
            repeat {
                if i >= else_len { break }
                gen_statement(else_body[i])
                i = i + 1
            } til i >= else_len
            pop_scope()
            emit_inst("br label %" + merge_label)
        }
        
        emit_label(merge_label + ":")
        return
    }
    if type == "Repeat" {
        var body = stmt[1]
        var cond = stmt[2]
        
        var loop_label = "loop_" + str(temp_count[0])
        var cond_label = "cond_" + str(temp_count[0])
        var merge_label = "merge_" + str(temp_count[0])
        temp_count[0] = temp_count[0] + 1
        
        append(g_loop_breaks[0], merge_label)
        append(g_loop_continues[0], cond_label)
        
        emit_inst("br label %" + loop_label)
        emit_label(loop_label + ":")
        push_scope()
        var i = 0
        var body_len = len(body)
        repeat {
            if i >= body_len { break }
            gen_statement(body[i])
            i = i + 1
        } til i >= body_len
        pop_scope()
        
        pop(g_loop_breaks[0])
        pop(g_loop_continues[0])
        
        emit_inst("br label %" + cond_label)
        emit_label(cond_label + ":")
        var cond_i1 = "%cond_i1_" + str(temp_count[0])
        temp_count[0] = temp_count[0] + 1
        if can_gen_static_cmp(cond) {
            cond_i1 = gen_static_cmp(cond)
        } else {
            var cond_reg = gen_expr(cond)
            emit_inst(cond_i1 + " = call i1 @llvm_val_to_bool(ptr " + cond_reg + ")")
        }
        emit_inst("br i1 " + cond_i1 + ", label %" + merge_label + ", label %" + loop_label)
        
        emit_label(merge_label + ":")
        return
    }
    if type == "TryCatch" {
        var try_body = stmt[1]
        var err_var = stmt[2]
        var catch_body = stmt[3]
        
        var catch_label = "catch_" + str(temp_count[0])
        var end_label = "try_end_" + str(temp_count[0])
        temp_count[0] = temp_count[0] + 1
        
        append(g_catch_labels[0], catch_label)
        append(g_catch_vars[0], "%wyrm_var_" + err_var)
        
        append(g_allocas[0], "  %wyrm_var_" + err_var + " = alloca %struct.Value, align 8")
        
        push_scope()
        var i = 0
        var try_len = len(try_body)
        repeat {
            if i >= try_len { break }
            gen_statement(try_body[i])
            i = i + 1
        } til i >= try_len
        pop_scope()
        
        pop(g_catch_labels[0])
        pop(g_catch_vars[0])
        
        emit_inst("br label %" + end_label)
        
        emit_label(catch_label + ":")
        push_scope()
        i = 0
        var catch_len = len(catch_body)
        repeat {
            if i >= catch_len { break }
            gen_statement(catch_body[i])
            i = i + 1
        } til i >= catch_len
        pop_scope()
        emit_inst("br label %" + end_label)
        
        emit_label(end_label + ":")
        return
    }
    if type == "Unsafe" {
        var body = stmt[1]
        var old_unsafe = in_unsafe[0]
        in_unsafe[0] = true
        push_scope()
        var i = 0
        var body_len = len(body)
        repeat {
            if i >= body_len { break }
            gen_statement(body[i])
            i = i + 1
        } til i >= body_len
        pop_scope()
        in_unsafe[0] = old_unsafe
        return
    }
    if type == "Arena" {
        var name = stmt[1]
        var size = stmt[2]
        var size_reg = gen_expr(size)
        emit_inst("%wyrm_arena_" + name + " = call ptr @val_arena_create_wrapper(ptr " + size_reg + ")")
        var scopes_list = g_scopes[0]
        var scope_idx = len(scopes_list) - 1
        var scope = scopes_list[scope_idx]
        var arenas = scope[0]
        append(arenas, name)
        return


    }
    if type == "Return" {
        var expr = stmt[1]
        if expr != null {
            var val_reg = gen_expr(expr)
            emit_inst("call void @llvm_val_copy(ptr %result_ptr, ptr " + val_reg + ")")
        } else {
            emit_inst("call void @llvm_val_null(ptr %result_ptr)")
        }
        gen_all_cleanups()
        emit_inst("ret void")
        return
    }
    if type == "Break" {
        gen_all_cleanups()
        var size = len(g_loop_breaks[0])
        if size > 0 {
            var breaks_list = g_loop_breaks[0]
            var target = breaks_list[size - 1]
            emit_inst("br label %" + target)
        }
        var dead_block = "dead_block_" + str(temp_count[0])
        temp_count[0] = temp_count[0] + 1
        emit_label(dead_block + ":")
        return
    }
    if type == "Continue" {
        gen_all_cleanups()
        var size = len(g_loop_continues[0])
        if size > 0 {
            var continues_list = g_loop_continues[0]
            var target = continues_list[size - 1]
            emit_inst("br label %" + target)
        }
        var dead_block = "dead_block_" + str(temp_count[0])
        temp_count[0] = temp_count[0] + 1
        emit_label(dead_block + ":")
        return
    }
    
    // Expression statement
    gen_expr(stmt)
}

fn emit_label(label) {
    if in_function[0] {
        append(g_insts[0], label)
    } else {
        append(g_llvm_main, label)
    }
}

fn check_expr(expr, error_funcs, in_try_stmt, in_try_expr, in_catch_expr, func_returns_error) {
    if not is_array(expr) { return; }
    var n_type = expr[0]
    
    if n_type == "FuncCall" {
        var func_node = expr[1]
        var name = func_node[1]
        var is_err_func = false
        var j = 0
        var el = len(error_funcs)
        repeat {
            if j >= el { break }
            if error_funcs[j] == name { is_err_func = true }
            j = j + 1
        } til j >= el
        
        if is_err_func and not in_try_stmt and not in_try_expr and not in_catch_expr and not func_returns_error {
            report_diagnostic("E0004", "unhandled error: function '" + name + "' returns !Error but is called without try/catch handling", 0, 0, "wrap in try or annotate calling function with !Error")
        }
        
        var args = expr[2]
        var i = 0
        var al = len(args)
        repeat {
            if i >= al { break }
            check_expr(args[i], error_funcs, in_try_stmt, in_try_expr, in_catch_expr, func_returns_error)
            i = i + 1
        } til i >= al
    } elif n_type == "TryExpr" {
        check_expr(expr[1], error_funcs, in_try_stmt, true, in_catch_expr, func_returns_error)
    } elif n_type == "CatchExpr" {
        check_expr(expr[1], error_funcs, in_try_stmt, in_try_expr, true, func_returns_error)
        check_expr(expr[2], error_funcs, in_try_stmt, in_try_expr, false, func_returns_error)
    } elif n_type == "BinaryOp" {
        check_expr(expr[2], error_funcs, in_try_stmt, in_try_expr, in_catch_expr, func_returns_error)
        check_expr(expr[3], error_funcs, in_try_stmt, in_try_expr, in_catch_expr, func_returns_error)
    } elif n_type == "UnaryOp" {
        check_expr(expr[2], error_funcs, in_try_stmt, in_try_expr, in_catch_expr, func_returns_error)
    } elif n_type == "Array" {
        var elems = expr[1]
        var i = 0
        var el = len(elems)
        repeat {
            if i >= el { break }
            check_expr(elems[i], error_funcs, in_try_stmt, in_try_expr, in_catch_expr, func_returns_error)
            i = i + 1
        } til i >= el
    } elif n_type == "Index" {
        check_expr(expr[1], error_funcs, in_try_stmt, false, false, func_returns_error)
        check_expr(expr[2], error_funcs, in_try_stmt, false, false, func_returns_error)
    } elif n_type == "Slice" {
        check_expr(expr[1], error_funcs, in_try_stmt, false, false, func_returns_error)
        check_expr(expr[2], error_funcs, in_try_stmt, false, false, func_returns_error)
        check_expr(expr[3], error_funcs, in_try_stmt, false, false, func_returns_error)
    }
}

fn check_stmt(stmt, error_funcs, in_try_stmt, func_returns_error) {
    if not is_array(stmt) { return; }
    var n_type = stmt[0]
    
    if n_type == "VarDecl" {
        check_expr(stmt[3], error_funcs, in_try_stmt, false, false, func_returns_error)
    } elif n_type == "Assign" {
        check_expr(stmt[2], error_funcs, in_try_stmt, false, false, func_returns_error)
    } elif n_type == "IndexAssign" {
        check_expr(stmt[3], error_funcs, in_try_stmt, false, false, func_returns_error)
    } elif n_type == "Print" {
        var exprs = stmt[1]
        var i = 0
        var el = len(exprs)
        repeat {
            if i >= el { break }
            check_expr(exprs[i], error_funcs, in_try_stmt, false, false, func_returns_error)
            i = i + 1
        } til i >= el
    } elif n_type == "Return" {
        check_expr(stmt[1], error_funcs, in_try_stmt, false, false, func_returns_error)
    } elif n_type == "Repeat" {
        check_expr(stmt[2], error_funcs, in_try_stmt, false, false, func_returns_error)
        var body = stmt[1]
        var i = 0
        var bl = len(body)
        repeat {
            if i >= bl { break }
            check_stmt(body[i], error_funcs, in_try_stmt, func_returns_error)
            i = i + 1
        } til i >= bl
    } elif n_type == "Unsafe" {
        var body = stmt[1]
        var i = 0
        var bl = len(body)
        repeat {
            if i >= bl { break }
            check_stmt(body[i], error_funcs, in_try_stmt, func_returns_error)
            i = i + 1
        } til i >= bl
    } elif n_type == "If" {
        check_expr(stmt[1], error_funcs, in_try_stmt, false, false, func_returns_error)
        var then_body = stmt[2]
        var i = 0
        var bl = len(then_body)
        repeat {
            if i >= bl { break }
            check_stmt(then_body[i], error_funcs, in_try_stmt, func_returns_error)
            i = i + 1
        } til i >= bl
        var elif_clauses = stmt[3]
        i = 0
        var ecl = len(elif_clauses)
        repeat {
            if i >= ecl { break }
            var clause = elif_clauses[i]
            check_expr(clause[0], error_funcs, in_try_stmt, false, false, func_returns_error)
            var elif_body = clause[1]
            var j = 0
            var ebl = len(elif_body)
            repeat {
                if j >= ebl { break }
                check_stmt(elif_body[j], error_funcs, in_try_stmt, func_returns_error)
                j = j + 1
            } til j >= ebl
            i = i + 1
        } til i >= ecl
        var else_body = stmt[4]
        i = 0
        var elbl = len(else_body)
        repeat {
            if i >= elbl { break }
            check_stmt(else_body[i], error_funcs, in_try_stmt, func_returns_error)
            i = i + 1
        } til i >= elbl
    } elif n_type == "TryCatch" {
        var try_body = stmt[1]
        var catch_body = stmt[3]
        var i = 0
        var tbl = len(try_body)
        repeat {
            if i >= tbl { break }
            check_stmt(try_body[i], error_funcs, true, func_returns_error)
            i = i + 1
        } til i >= tbl
        i = 0
        var cbl = len(catch_body)
        repeat {
            if i >= cbl { break }
            check_stmt(catch_body[i], error_funcs, in_try_stmt, func_returns_error)
            i = i + 1
        } til i >= cbl
    } elif n_type == "Arena" {
        check_expr(stmt[2], error_funcs, in_try_stmt, false, false, func_returns_error)
    }
}

fn check_errors(ast) {
    var error_funcs = []
    
    // First pass: collect error-returning function names
    var i = 0
    var l = len(ast)
    repeat {
        if i >= l { break }
        var stmt = ast[i]
        if stmt[0] == "FuncDef" {
            var returns_error = stmt[4]
            if returns_error {
                append(error_funcs, stmt[1])
            }
        }
        i = i + 1
    } til i >= l
    
    // Second pass: check handling in functions and top-level
    i = 0
    repeat {
        if i >= l { break }
        var stmt = ast[i]
        if stmt[0] == "FuncDef" {
            var returns_error = stmt[4]
            var body = stmt[3]
            var j = 0
            var bl = len(body)
            repeat {
                if j >= bl { break }
                check_stmt(body[j], error_funcs, false, returns_error)
                j = j + 1
            } til j >= bl
        } else {
            check_stmt(stmt, error_funcs, false, false)
        }
        i = i + 1
    } til i >= l
}

fn transpile_llvm(ast) {
    g_llvm_globals = []
    g_llvm_decls = []
    g_llvm_funcs = []
    g_llvm_main = []
    has_main_def[0] = false
    temp_count[0] = 0
    
    // Generate declarations
    append(g_llvm_globals, "; Module generated by Wyrm 3.1.0 Self-Hosted LLVM backend")
    append(g_llvm_globals, "target datalayout = \"e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\"")
    append(g_llvm_globals, "target triple = \"x86_64-pc-windows-msvc\"")
    append(g_llvm_globals, "%struct.Value = type { i32, %union.anon }")
    append(g_llvm_globals, "%union.anon = type { double }")
    
    // Add forward decls
    append(g_llvm_decls, "declare void @llvm_val_null(ptr)")
    append(g_llvm_decls, "declare void @llvm_val_bool(ptr, i1)")
    append(g_llvm_decls, "declare void @llvm_val_number(ptr, double)")
    append(g_llvm_decls, "declare void @llvm_val_string(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_array_create(ptr, i32)")
    append(g_llvm_decls, "declare void @llvm_val_array_init(ptr, i32, ...)")
    append(g_llvm_decls, "declare i1 @llvm_val_to_bool(ptr)")
    append(g_llvm_decls, "declare void @llvm_val_print(i32, ...)")
    append(g_llvm_decls, "declare void @llvm_val_input(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_len(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_type(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_int(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_float(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_str(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_abs(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_round(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_pow(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_add(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_sub(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_mul(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_div(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_mod(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_floordiv(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_eq(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_ne(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_lt(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_gt(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_le(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_ge(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_and(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_or(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_not(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_array_get(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_array_set(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_array_append(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_array_pop(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_array_slice(ptr, ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_raw_malloc(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_raw_realloc(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_raw_free(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_raw_ptr(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_arena_alloc(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_arena_reset(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_read_file(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_error_val(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_write_file(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_exit(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_system(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_getenv(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_split(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_join(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_trim(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_upper(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_lower(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_contains(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_replace(ptr, ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_starts_with(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_ends_with(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_char_at(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_ord_val(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_chr_val(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_to_bytes(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_from_bytes(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_copy(ptr, ptr)")
    append(g_llvm_decls, "declare ptr @val_arena_create_wrapper(ptr)")
    append(g_llvm_decls, "declare void @arena_destroy(ptr)")
    append(g_llvm_decls, "declare void @val_init_sys_args(i32, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_struct_create(ptr, ptr, i32)")
    append(g_llvm_decls, "declare void @llvm_val_struct_get(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_struct_set(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_from_i64(ptr, i64)")
    append(g_llvm_decls, "declare void @llvm_val_from_u8(ptr, i8)")
    append(g_llvm_decls, "declare void @llvm_val_from_f32(ptr, float)")
    append(g_llvm_decls, "declare void @llvm_val_from_bool(ptr, i1)")
    append(g_llvm_decls, "declare void @llvm_val_drop(ptr)")
    append(g_llvm_decls, "declare void @llvm_val_json_parse(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_json_encode(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_json_pretty(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_json_get(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_json_has(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_json_set(ptr, ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_json_object(ptr)")
    append(g_llvm_decls, "declare void @llvm_val_yaml_parse(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_yaml_encode(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_map_new(ptr)")
    append(g_llvm_decls, "declare void @llvm_val_map_set(ptr, ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_map_get(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_map_has(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_map_del(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_map_keys(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_map_values(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_map_len(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_set_new(ptr)")
    append(g_llvm_decls, "declare void @llvm_val_set_add(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_set_has(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_set_del(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_set_union(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_set_intersect(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_set_to_array(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_sdl_init(ptr)")
    append(g_llvm_decls, "declare void @llvm_val_sdl_quit(ptr)")
    append(g_llvm_decls, "declare void @llvm_val_sdl_window(ptr, ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_sdl_destroy_window(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_sdl_poll_event(ptr)")
    append(g_llvm_decls, "declare void @llvm_val_sdl_clear(ptr, ptr, ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_sdl_present(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_sdl_draw_rect(ptr, ptr, ptr, ptr, ptr, ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_sdl_draw_line(ptr, ptr, ptr, ptr, ptr, ptr, ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_sdl_delay(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_sdl_ticks(ptr)")
    append(g_llvm_decls, "declare void @llvm_val_ffi_open(ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_ffi_sym(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_ffi_call(ptr, ptr, ptr)")
    append(g_llvm_decls, "declare void @llvm_val_ffi_close(ptr, ptr)")
    append(g_llvm_decls, "@wyrm_sys_args = external global %struct.Value, align 8")

    declared_globals[0] = []
    emitted_globals[0] = []
    g_main_allocas[0] = []
    g_loop_breaks[0] = []
    g_loop_continues[0] = []
    collect_globals_from_stmts(ast)

    // Check if main func is defined
    var idx = 0
    var length = len(ast)
    repeat {
        if idx >= length { break }
        var stmt = ast[idx]
        if stmt[0] == "FuncDef" and stmt[1] == "main" {
            has_main_def[0] = true
        }
        idx = idx + 1
    } til idx >= length

    // Analyze types for top-level scope
    analyze_scope_types(ast, [])

    // Process AST statements
    idx = 0
    repeat {
        if idx >= length { break }
        gen_statement(ast[idx])
        idx = idx + 1
    } til idx >= length

    // Build the final LLVM IR code
    var result = ""
    
    // Add globals
    idx = 0
    length = len(g_llvm_globals)
    repeat {
        if idx >= length { break }
        result = result + g_llvm_globals[idx] + "\n"
        idx = idx + 1
    } til idx >= length
    result = result + "\n"

    // Add decls
    idx = 0
    length = len(g_llvm_decls)
    repeat {
        if idx >= length { break }
        result = result + g_llvm_decls[idx] + "\n"
        idx = idx + 1
    } til idx >= length
    result = result + "\n"

    // Add functions
    idx = 0
    length = len(g_llvm_funcs)
    repeat {
        if idx >= length { break }
        result = result + g_llvm_funcs[idx] + "\n"
        idx = idx + 1
    } til idx >= length
    result = result + "\n"

    // Add main function
    result = result + "define i32 @main(i32 %argc, ptr %argv) {\n"
    result = result + "  call void @val_init_sys_args(i32 %argc, ptr %argv)\n"
    
    // Add main function allocas
    idx = 0
    var m_allocs = g_main_allocas[0]
    var m_len = len(m_allocs)
    repeat {
        if idx >= m_len { break }
        result = result + m_allocs[idx] + "\n"
        idx = idx + 1
    } til idx >= m_len
    
    // Add top-level allocations if any
    idx = 0
    length = len(g_llvm_main)
    repeat {
        if idx >= length { break }
        result = result + g_llvm_main[idx] + "\n"
        idx = idx + 1
    } til idx >= length

    if has_main_def[0] {
        var t = "%tmp_main_res"
        result = result + "  " + t + " = alloca %struct.Value, align 8\n"
        result = result + "  call void @wyrm_fn_main(ptr " + t + ")\n"
    }
    
    result = result + "  ret i32 0\n"
    result = result + "}\n"

    return result
}

fn parse_file(path, processed_files) {
    if contains_val(processed_files, path) { return [] }
    append(processed_files, path)
    if path == "std.json" or path == "std.yaml" or path == "std.collections" or path == "std.sdl" or path == "std.ffi" or path == "std.thread" {
        return []
    }
    
    // Resolve path
    var content = read_file(path)
    if content == null {
        content = read_file(path + ".wyr")
    }
    if content == null {
        content = read_file("packages/" + path)
    }
    if content == null {
        content = read_file("packages/" + path + ".wyr")
    }
    if content == null {
        // Check home directory
        var home = getenv("USERPROFILE")
        if home == null { home = getenv("HOME") }
        if home != null {
            content = read_file(home + "/.wyrm/packages/" + path)
            if content == null {
                content = read_file(home + "/.wyrm/packages/" + path + ".wyr")
            }
        }
    }
    if content == null {
        print("Compiler Error: Cannot find module '" + path + "'")
        exit(1)
    }
    
    var tokens = tokenize(content)
    current_source_file[0] = path
    current_source_lines[0] = split(content, "\n")
    var file_ast = parse_tokens(tokens)
    
    // Process "use" statements in file_ast
    var full_ast = []
    var i = 0
    var l = len(file_ast)
    repeat {
        if i >= l { break }
        var stmt = file_ast[i]
        if stmt[0] == "Use" {
            var sub_ast = parse_file(stmt[1], processed_files)
            var j = 0
            var sl = len(sub_ast)
            repeat {
                if j >= sl { break }
                append(full_ast, sub_ast[j])
                j = j + 1
            } til j >= sl
        } else {
            append(full_ast, stmt)
        }
        i = i + 1
    } til i >= l
    
    return full_ast
}

fn main() {
    var args = sys_args()
    if len(args) < 2 {
        print("wyrmc v3.1.0 (Self-Hosted)")
        print("Usage:")
        print("  wyrmc build <file.wyr> [-o <out.exe>]")
        print("  wyrmc run <file.wyr> [args...]")
        print("  wyrmc --version")
        print("  wyrmc --help")
        exit(0)
    }

    var command = args[1]
    if command == "--version" or command == "-v" or command == "version" {
        print("wyrmc v3.1.0 (Self-Hosted)")
        exit(0)
    }

    if command == "--help" or command == "-h" or command == "help" {
        print("wyrmc v3.1.0 (Self-Hosted)")
        print("Usage:")
        print("  wyrmc build <file.wyr> [-o <out.exe>]")
        print("  wyrmc run <file.wyr> [args...]")
        print("  wyrmc --version")
        print("  wyrmc --help")
        exit(0)
    }

    if command != "build" and command != "run" {
        print("Error: Unknown compiler command '" + command + "'")
        print("Run 'wyrmc --help' for usage instructions.")
        exit(1)
    }

    if len(args) < 3 {
        print("Error: Missing input source file.")
        print("Run 'wyrmc --help' for usage instructions.")
        exit(1)
    }

    var source_file = args[2]

    // Determine output executable name
    var out_exe = "a.exe"
    var last_dot = len(source_file)
    var i = len(source_file) - 1
    repeat {
        if i < 0 { break }
        var char = char_at(source_file, i)
        if char == "." {
            last_dot = i
            break
        }
        if char == "/" or char == "\\" {
            break
        }
        i = i - 1
    } til i < 0
    
    // Extract base name
    var base_name = ""
    i = 0
    repeat {
        if i >= last_dot { break }
        base_name = base_name + char_at(source_file, i)
        i = i + 1
    } til i >= last_dot
    out_exe = base_name + ".exe"

    if command == "run" {
        out_exe = base_name + "_run.exe"
    }

    // Check custom output -o
    if len(args) >= 5 {
        if args[3] == "-o" {
            out_exe = args[4]
        }
    }

    var temp_ll_file = base_name + "_temp.ll"

    // Parse source file and all its includes
    var processed = []
    var ast = parse_file(source_file, processed)

    // Perform static error handling checks
    check_errors(ast)

    // Transpile to LLVM IR
    var llvm_ir = transpile_llvm(ast)

    // Write LLVM IR to temp file
    var write_ok = write_file(temp_ll_file, llvm_ir)
    if not write_ok {
        print("Error: Could not write temporary LLVM IR file '" + temp_ll_file + "'")
        exit(1)
    }

    // Resolve Wyrm library paths to compile the runtime
    var home = getenv("USERPROFILE")
    if home == null { home = getenv("HOME") }
    var lib_path = "wyrm/lib/"
    var f_check = read_file(lib_path + "wyrm_core.c")
    if f_check == null and home != null {
        lib_path = home + "/.wyrm/packages/wyrmlang/lib/"
    }

    var runtime_c = lib_path + "wyrm_core.c"
    var arena_c = lib_path + "wyrm_arena.c"
    var str_c = lib_path + "wyrm_str.c"
    var ffi_c = lib_path + "wyrm_ffi.c"
    var std_json_c = lib_path + "stdlib/wyrm_std_json.c"
    var std_yaml_c = lib_path + "stdlib/wyrm_std_yaml.c"
    var std_sdl_c = lib_path + "stdlib/wyrm_std_sdl.c"
    var std_coll_c = lib_path + "stdlib/wyrm_std_collections.c"

    var all_runtime = "\"" + runtime_c + "\" \"" + arena_c + "\" \"" + str_c + "\" \"" + ffi_c + "\" \"" + std_json_c + "\" \"" + std_yaml_c + "\" \"" + std_sdl_c + "\" \"" + std_coll_c + "\""
    var inc_flags = "-I\"" + lib_path + "\" -D_CRT_SECURE_NO_WARNINGS -D_CRT_NONSTDC_NO_DEPRECATE -Wno-deprecated-declarations -Wno-switch -Wno-override-module"

    // Discover clang executable
    var clang_cmd = "clang"
    var test_res = system("clang --version > nul 2>&1")
    if test_res != 0 {
        var clang_check = read_file("C:\\Program Files\\LLVM\\bin\\clang.exe")
        if clang_check != null {
            clang_cmd = "\"C:\\Program Files\\LLVM\\bin\\clang.exe\""
        }
    }

    // Compile temp_ll_file + C runtime to native executable using clang
    var compile_cmd = clang_cmd + " -O2 " + inc_flags + " \"" + temp_ll_file + "\" " + all_runtime + " -o \"" + out_exe + "\""
    
    // Execute clang
    var res = system("\"" + compile_cmd + "\"")

    if res != 0 {
        print("Compilation Error: LLVM/clang failed to compile target executable.")
        exit(1)
    }

    if command == "run" {
        var native_exe = ""
        var p_idx = 0
        var p_len = len(out_exe)
        repeat {
            if p_idx >= p_len { break }
            var ch = char_at(out_exe, p_idx)
            if ch == "/" {
                native_exe = native_exe + "\\"
            } else {
                native_exe = native_exe + ch
            }
            p_idx = p_idx + 1
        } til p_idx >= p_len
        var run_cmd = "\"" + native_exe + "\""
        var run_res = system(run_cmd)
        exit(run_res)
    }

    print("[wyrmc v3.1.0] Successfully compiled '" + source_file + "' -> Native Binary '" + out_exe + "'")
}
