{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Wyrm",
  "scopeName": "source.wyr",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#struct-definitions"
    },
    {
      "include": "#function-definitions"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#numbers"
    },

    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.documentation.wyr",
          "match": "///.*"
        },
        {
          "name": "comment.line.double-slash.wyr",
          "match": "//.*"
        },
        {
          "name": "comment.block.wyr",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.wyr",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.wyr",
              "match": "\\\\(n|t|r|\\\\|\")"
            }
          ]
        },
        {
          "name": "string.quoted.single.wyr",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.wyr",
              "match": "\\\\(n|t|r|\\\\|')"
            }
          ]
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.wyr",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.wyr",
          "match": "\\b(if|elif|else|repeat|do|til|break|continue|return|use|unsafe|arena|struct)\\b"
        },
        {
          "name": "variable.language.self.wyr",
          "match": "\\bself\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "storage.type.wyr",
          "match": "\\b(var|dec|owned|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|char|string|int|float|number|raw_ptr)\\b"
        }
      ]
    },
    "struct-definitions": {
      "patterns": [
        {
          "match": "\\b(struct)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "storage.type.struct.wyr"
            },
            "2": {
              "name": "entity.name.type.struct.wyr"
            }
          }
        }
      ]
    },
    "function-definitions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "storage.type.function.wyr"
            },
            "2": {
              "name": "entity.name.function.wyr"
            }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.wyr"
            }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.wyr",
          "match": "\\b(print|input|int|float|str|len|type|abs|max|min|round|pow|append|pop|open|read|write|close|malloc|free|realloc|split|join|trim|upper|lower|contains|replace|starts_with|ends_with|char_at|ord_val|chr_val|to_bytes|from_bytes|read_file|write_file|json_parse|json_encode|json_pretty|yaml_parse|yaml_encode|map_new|map_set|map_get|map_has|map_len|set_new|set_add|set_has|sdl_init|sdl_window|sdl_poll_event|sdl_clear|sdl_present|sdl_delay|sdl_quit|ffi_open|ffi_sym|ffi_call|ffi_close|thread_spawn|thread_join|mutex_new|mutex_lock|mutex_unlock|mutex_destroy)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.wyr",
          "match": "\\b(and|or|not)\\b|&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.compound.wyr",
          "match": "\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.comparison.wyr",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.wyr",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.wyr",
          "match": "\\*\\*|//|\\+|-|\\*|/|%"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.wyr",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.wyr",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.parameters.begin.wyr",
          "match": "\\("
        },
        {
          "name": "punctuation.definition.parameters.end.wyr",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.block.begin.wyr",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.wyr",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.bracket.begin.wyr",
          "match": "\\["
        },
        {
          "name": "punctuation.section.bracket.end.wyr",
          "match": "\\]"
        },
        {
          "name": "punctuation.separator.comma.wyr",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.wyr",
          "match": ";"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.wyr",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}

