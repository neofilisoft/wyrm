# ============================================================
# GitHub Linguist Configuration for Wyrm Repository
# Goal: Wyrm (most) > C (second) > others (minor/excluded)
# ============================================================

# --- Wyrm source files: PRIMARY language ---
# Force detection and ensure not excluded
*.wyr linguist-language=Wyrm
*.wyr linguist-detectable=true

# --- C runtime library: keep as real code ---
*.c linguist-language=C
*.c linguist-detectable=true
wyrm/lib/wyrm_arena.c linguist-detectable=true
wyrm/lib/wyrm_core.c linguist-detectable=true
wyrm/lib/wyrm_str.c linguist-detectable=true
wyrm/scr/bootstrap.c linguist-detectable=true

# --- C++ bootstrap compiler toolchain: infrastructure, not the project language ---
# The .cpp files are the bootstrap stage only; once Wyrm is self-hosted they become vendored.
*.cpp linguist-vendored=true
*.hpp linguist-vendored=true

# --- Python: interpreter/tooling infrastructure, not the project language ---
*.py linguist-vendored=true
*.py linguist-detectable=false

# --- HTML: vendored (heavy file wyrm.html) ---
*.html linguist-vendored=true

# --- JavaScript: vendored ---
*.js linguist-vendored=true

# --- CMake: vendored ---
CMakeLists.txt linguist-vendored=true

# --- Generated/cache files ---
__pycache__/** linguist-vendored=true
*.pyc linguist-vendored=true
.pytest_cache/** linguist-vendored=true
# CSS: browser demo styling, not the project language
*.css linguist-vendored=true

# JSON: editor/package metadata
*.json linguist-vendored=true

# Bytecode output
*.wyb linguist-generated=true

# Package metadata cache
wyrmlang.egg-info/** linguist-generated=true

