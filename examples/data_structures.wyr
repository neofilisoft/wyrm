// Data structures examples in Wyrm

// Arrays (lists)
numbers = [1, 2, 3, 4, 5]
print("Numbers: " + str(numbers))

// Accessing elements
first = numbers[0]
second = numbers[1]
last = numbers[4]  // or numbers[len(numbers)-1]
print("First: " + str(first))
print("Second: " + str(second))
print("Last: " + str(last))

// Modifying elements
numbers[0] = 10
print("Modified numbers: " + str(numbers))

// Getting length
length = len(numbers)
print("Length: " + str(length))

// Mixed array
mixed = [1, "hello", 3.14, true]
print("Mixed array: " + str(mixed))

// Strings as arrays of characters (conceptual)
text = "Hello"
first_char = text[0]  // Would be 'H' if implemented
print("First character: " + str(first_char))

// String length
text_len = len(text)
print("Length of text: " + str(text_len))

// Array operations (conceptual - would need to be implemented)
// In a full implementation, we might have:
// append(arr, item) - add item to end
// pop(arr) - remove and return last item
// slice(arr, start, end) - get substring/sublist

// Example of using arrays for calculations
scores = [85, 92, 78, 96, 88]
total = 0
i = 0
repeat {
    total = total + scores[i]
    i = i + 1
} til (i >= len(scores))
average = total / len(scores)
print("Average score: " + str(average))

// Finding maximum in array
max_score = scores[0]
i = 1
repeat {
    if scores[i] > max_score {
        max_score = scores[i]
    }
    i = i + 1
} til (i >= len(scores))
print("Maximum score: " + str(max_score))