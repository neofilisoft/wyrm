// examples/test_sdl_debug.wyr - Single-frame SDL2 debug test
use sdl;

fn main() {
    sdl_init()
    var win  = sdl_window("Wyrm Game Test", 640, 480)
    var rend = sdl_renderer(win)
    print("Window created successfully!")
    print("Calling sdl_poll_event...")
    var ev = sdl_poll_event()
    print("Poll event done!")
    print("Calling sdl_clear...")
    sdl_clear(rend, 20, 30, 50)
    print("Clear done!")
    print("Calling sdl_present...")
    sdl_present(rend)
    print("Present done!")
    sdl_delay(100)
    sdl_destroy_renderer(rend)
    sdl_destroy_window(win)
    sdl_quit()
    print("All done!")
}
