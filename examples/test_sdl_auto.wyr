use std.sdl;

fn main() {
    sdl_init()
    var win = sdl_window("Wyrm Game Test", 640, 480)
    print("Window created successfully!")
    var frame = 0

    do {
        var ev = sdl_poll_event()
        sdl_clear(win, 20, 30, 50)
        sdl_present(win)
        sdl_delay(16)
        frame = frame + 1
    } til frame >= 10

    sdl_quit()
    print("SDL test passed successfully!")
}
