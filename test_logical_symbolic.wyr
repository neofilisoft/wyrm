// Test logical operators with symbols
a = true
b = false

// Test AND
c = a && b
print("a && b = " + c)  // Should be false

d = a && a
print("a && a = " + d)  // Should be true

e = b && b
print("b && b = " + e)  // Should be false

// Test OR
f = a || b
print("a || b = " + f)  // Should be true

g = b || b
print("b || b = " + g)  // Should be false

// Test NOT
h = !a
print("!a = " + h)      // Should be false

i = !b
print("!b = " + i)      // Should be true

// Mixed expressions
j = (a && b) || (!a && b)
print("(a && b) || (!a && b) = " + j)  // Should be false

k = (a || b) && !(a && b)
print("(a || b) && !(a && b) = " + k)  // Should be true (XOR)